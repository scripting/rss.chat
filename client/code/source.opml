						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm before publishing.&quot;, &quot;flConfirmPublish&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm after first publish.&quot;, &quot;flConfirmAfterFirstPublish&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm linkblog posts.&quot;, &quot;flConfirmLinkblogPosts&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Audible icon clicks.&quot;, &quot;flAudibleIconClicks&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Bookmarks menu.&quot;, &quot;flBookmarksMenu&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Close editor after publish.&quot;, &quot;flCloseEditorAfterPublish&quot;)%&gt;">
						</outline>
					</outline>
					<outline text="CSS">
					</outline>
					<outline text="AI code">
						<outline text="&lt;%prefs.textAreaPref (&quot;AI prompt&quot;, &quot;aiPrompt&quot;, &quot;Enter your initial instructions for your AI system.&quot;, 70, 15)%&gt;">
						</outline>
					</outline>
				</outline>
			</outline>
			<outline text="readme.md">
				<outline text="# rss.chat">
					<outline text="A simple chat app based on RSS and other standard web technologies...">
					</outline>
				</outline>
			</outline>
		</outline>
		<outline text="/scripting.com/code/rsschat/" isComment="true">
			<outline text="worknotes.md">
				<outline text="7/4/26; 5:09:06 PM by DW">
					<outline text="Removed hoist and dehoist from the left side icon bar.">
					</outline>
					<outline text="Removed eye icon, from item icons, moved delete icon to the popup menu">
					</outline>
				</outline>
				<outline text="7/2/26; 10:04:43 AM by DW">
					<outline text="Split off from the rssNetwork project.">
					</outline>
					<outline text="Kept the locations for the files the same, so I don't need to mess with that and create a big transition.">
					</outline>
					<outline text="I want to get started in documenting this stuff, fixing bugs, finializing the UI. ">
					</outline>
					<outline text="New -- appConsts.version.">
					</outline>
					<outline text="">
					</outline>
					<outline text="thought about moving the ">

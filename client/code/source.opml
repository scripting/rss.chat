					<outline text="function createAccountCommand () {" isComment="true">
						<outline text="Changes" isComment="true">
							<outline text="6/5/26; 11:46:56 AM by DW">
								<outline text="We need to have this one bit in localStorage, because this is a point where we don't have a place to store it on the server. We also store it in appPrefs.lastEmail. ">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;createAccountCommand&quot;);">
						</outline>
						<outline text="const defaultAddress = (localStorage.lastEmailAccount !== undefined) ? localStorage.lastEmailAccount : &quot;&quot;;">
						</outline>
						<outline text="askDialog (&quot;Enter your email address:&quot;, defaultAddress, &quot;you@example.com&quot;, function (email, flCancelled) {">
							<outline text="if (!flCancelled) {">
								<outline text="email = trimWhitespace (email);">
								</outline>
								<outline text="if (!legalEmailAddress (email)) {">
									<outline text="alertDialog (&quot;Can't create the account because \&quot;&quot; + email + &quot;\&quot; is not a valid email address.&quot;);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="localStorage.lastEmailAccount = email">
									</outline>
									<outline text="appPrefs.lastEmail = email;" isComment="true">
									</outline>
									<outline text="prefsChanged ();" isComment="true">
									</outline>
									<outline text="globals.myRssNetwork.createAccount (email, function (err, data) {">
										<outline text="if (err) {">
											<outline text="alertDialog (err.message);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="alertDialog (data.message); //Please check your email, probably.">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function signInCommand () {">
						<outline text="console.log (&quot;signInCommand&quot;);">
						</outline>
						<outline text="const defaultAddress = (localStorage.lastEmailAccount !== undefined) ? localStorage.lastEmailAccount : &quot;&quot;;">
						</outline>
						<outline text="askDialog (&quot;Enter your email address:&quot;, defaultAddress, &quot;you@example.com&quot;, function (email, flCancelled) {">
							<outline text="if (!flCancelled) {">
								<outline text="email = trimWhitespace (email);">
								</outline>
								<outline text="if (!legalEmailAddress (email)) {">
									<outline text="alertDialog (&quot;Can't sign in because \&quot;&quot; + email + &quot;\&quot; is not a legal email address.&quot;);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="checkWithWhitelist (email, function (err, flWhitelisted) {">
										<outline text="if (err) {">
											<outline text="alertDialog (&quot;Can't open an account for \&quot;&quot; + email + &quot;\&quot; because there was an error authorizing the account.&quot;);">
											</outline>
											<outline text="}">
											</outline>

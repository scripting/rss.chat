						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function testGetItemByGuid () { //6/8/26 by DW">
					<outline text="const guid = &quot;https://rss.network/permalink?screenname=dave.winer&amp;id=8pmie7h1&quot;;">
					</outline>
					<outline text="globals.myRssNetwork.getItemByGuid (guid, function (err, theItem) {">

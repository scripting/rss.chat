					<outline text="function versionsDialog () { //6/28/26 by DW">
						<outline text="console.log (&quot;versionsDialog&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="const serverAddress = settingsFromServer.urlServer;">
						</outline>
						<outline text="const linkToServer = &quot;&lt;a href=\&quot;&quot; + serverAddress + &quot;\&quot; target=\&quot;_blank\&quot;&gt;&quot; + serverAddress + &quot;&lt;/a&gt;&quot;;">
						</outline>
						<outline text="const productname = settingsFromServer.productNameForDisplay;">
						</outline>
						<outline text="">
						</outline>
						<outline text="var htmltext = &quot;&quot;;">
						</outline>
						<outline text="function add (s) {">
							<outline text="htmltext += s;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="add (&quot;&lt;div class=\&quot;divAboutDialogText\&quot;&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;b&gt;Software versions&lt;/b&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;b&gt;About &quot; + productname + &quot;&lt;/b&gt;&quot;);" isComment="true">
						</outline>
						<outline text="add (&quot;&lt;ul&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Server address: &quot; + settingsFromServer.urlServer + &quot;&lt;/li&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Server version: v&quot; + globals.userData.serverVersion + &quot;.&lt;/li&gt;&quot;); //7/1/26 by DW">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Client version: v&quot; + appConsts.version + &quot;.&lt;/li&gt;&quot;); //7/2/26 by DW">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Server version: v&quot; + settingsFromServer.appServerVersion + &quot;.&lt;/li&gt;&quot;); //commented -- this is the version for daveAppServer" isComment="true">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Current theme: &quot; + firstCharUpper (appPrefs.currentThemeName) + &quot; v&quot; + getThemeVersion () + &quot;&lt;/li&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;li&gt;Theme version: v&quot; + getThemeVersion () + &quot;&lt;/li&gt;&quot;);" isComment="true">
						</outline>
						<outline text="">
						</outline>
						<outline text="var serverName = &quot;MySQL&quot;; //7/21/26 by DW">
						</outline>
						<outline text="if (globals.userData.databaseEngine !== undefined) {">
							<outline text="serverName = globals.userData.databaseEngine;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="add (&quot;&lt;li&gt;&quot; + serverName + &quot; version: v&quot; + globals.userData.mySqlVersion + &quot;&lt;/li&gt;&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="add (&quot;&lt;/ul&gt;&quot;);">
						</outline>
						<outline text="add (&quot;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="alertDialog (htmltext);">
						</outline>
						<outline text="}">
						</outline>
					</outline>

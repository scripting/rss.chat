						<outline text="}">
						</outline>
					</outline>
					<outline text="function getItemByGuid (guid, callback) { //6/8/26 by DW">
						<outline text="Changes" isComment="true">
							<outline text="6/29/26; 8:47:40 AM by DW">
								<outline text="We're tracking down an error where this function is called with guid == undefined. Added debugging code to find the location.">
								</outline>
							</outline>
						</outline>
						<outline text="if (guid == undefined) {">
							<outline text="const message = &quot;Can't get the item record because the GUID param is undefined.&quot;;">
							</outline>
							<outline text="console.log (&quot;getItemByGuid: &quot; + message);">
							</outline>
							<outline text="console.trace ();">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const screenname = getScreenname (); //6/24/26 by DW">
							</outline>
							<outline text="servercall (&quot;getitembyguid&quot;, {screenname, guid}, false, &quot;GET&quot;, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function checkWhitelist (emailaddress, callback) { //6/9/26 by DW">

				<outline text="function testUpdatePost () { //5/21/26 by DW">
					<outline text="function getTimeString (theDate) {">
						<outline text="return (theDate.toLocaleTimeString ([], {hour: &quot;2-digit&quot;, minute: &quot;2-digit&quot;}));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="const postRec = {">
						<outline text="id: 115,">
						</outline>
						<outline text="title: getTimeString (new Date ()),">
						</outline>
						<outline text="description: &quot;Good morning sports fans. This is a post that i have updated after I published it. The first of many I hope! :-)&quot;">
						</outline>
						<outline text="};">

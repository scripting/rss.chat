																	<outline text="&lt;li&gt;&lt;a href=&quot;https://github.com/scripting/rss.chat/blob/main/server/code/worknotes.md&quot; target=&quot;_blank&quot;&gt;Server worknotes&lt;/a&gt;&lt;/li&gt;">
																	</outline>
																	<outline text="&lt;/ul&gt;">
																	</outline>
																</outline>
															</outline>
															<outline text="&lt;/li&gt;">
															</outline>
														</outline>
														<outline text="&lt;/ul&gt;">
														</outline>
													</outline>
													<outline text="&lt;/li&gt;">
													</outline>
												</outline>
												<outline text="&lt;li class=&quot;dropdown&quot; id=&quot;idOutlinerMenu&quot;&gt; " isComment="true">
													<outline text="&lt;a href=&quot;#&quot; class=&quot;dropdown-toggle&quot; data-toggle=&quot;dropdown&quot;&gt;Outline&amp;nbsp;&lt;b class=&quot;caret&quot;&gt;&lt;/b&gt;&lt;/a&gt;">
													</outline>
													<outline text="&lt;ul class=&quot;dropdown-menu&quot;&gt;">
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opExpand ();&quot;&gt;Expand&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opExpandAllLevels ();&quot;&gt;Expand All Subs&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opExpandEverything ();&quot;&gt;Expand Everything&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opCollapse ();&quot;&gt;Collapse&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opCollapseEverything ();&quot;&gt;Collapse Everything&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opFindCommand ();&quot;&gt;&lt;span class=&quot;menuKeystroke&quot;&gt;Cmd-F&lt;/span&gt;Find...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;opFindAgainCommand ();&quot;&gt;&lt;span class=&quot;menuKeystroke&quot;&gt;Cmd-G&lt;/span&gt;Find again&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;/ul&gt;">
														</outline>
													</outline>
													<outline text="&lt;/li&gt;">
													</outline>
												</outline>
												<outline text="&lt;/ul&gt;">
												</outline>
											</outline>
											<outline text="&lt;ul class=&quot;nav pull-right&quot;&gt;">
												<outline text="&lt;li class=&quot;dropdown&quot;&gt;">
													<outline text="&lt;a href=&quot;#&quot; class=&quot;dropdown-toggle&quot; data-toggle=&quot;dropdown&quot;&gt;">
														<outline text="&lt;i class=&quot;fa fa-user&quot; style=&quot;color: cornflowerblue;&quot;&gt;&lt;/i&gt;">
														</outline>
														<outline text="&lt;span id=&quot;idUsername&quot;&gt;&lt;/span&gt;">
														</outline>
														<outline text="&lt;span&gt;&amp;nbsp;&lt;b class=&quot;caret&quot;&gt;&lt;/b&gt;&lt;/span&gt;" isComment="true">
														</outline>
														<outline text="&lt;/a&gt;">
														</outline>
													</outline>
													<outline text="&lt;ul class=&quot;dropdown-menu&quot;&gt;">
														<outline text="&lt;li&gt;&lt;a onclick=&quot;versionsDialog ();&quot;&gt;Software versions...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;versionsDialog ();&quot;&gt;About [%productNameForDisplay%]...&lt;/a&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;settingsCommand ();&quot;&gt;Settings...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;createAccountCommand ()&quot; id=&quot;idCreateAccount&quot;&gt;Create account...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;signInCommand ()&quot; id=&quot;idSignIn&quot;&gt;Sign In...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;signOutCommand ()&quot; id=&quot;idSignOut&quot;&gt;Sign out...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="">
														</outline>
														<outline text="">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;viewUserInfo ();&quot;&gt;View user info&lt;/a&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;settingsCommand ();&quot;&gt;Settings...&lt;/a&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;logOffWordpress ();&quot;&gt;Log off WordPress.com&lt;/a&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="">
														</outline>
														<outline text="&lt;/ul&gt;">
														</outline>
													</outline>
													<outline text="&lt;/li&gt;">
													</outline>
												</outline>
												<outline text="&lt;/ul&gt;">
												</outline>
											</outline>
											<outline text="&lt;/div&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;/div&gt;">
									</outline>
								</outline>
								<outline text="&lt;/div&gt;">
								</outline>
							</outline>
							<outline text="&lt;/div&gt;">
							</outline>
						</outline>
						<outline text="&lt;div class=&quot;divChatContainer&quot;&gt;">
							<outline text="&lt;/div&gt;">
							</outline>
						</outline>
						<outline text="&lt;script&gt;">
							<outline text="$(document).ready (function () {">
								<outline text="startup ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="&lt;/script&gt;">
							</outline>
						</outline>
						<outline text="&lt;/body&gt;">
						</outline>
					</outline>
					<outline text="&lt;/html&gt;">
					</outline>
				</outline>
			</outline>
			<outline text="old stuff" isComment="true">
				<outline text="chat.css" isComment="true">
					<outline text="@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;display=swap');">
					</outline>
					<outline text="">
					</outline>
					<outline text=":root {">
						<outline text="--bg:        #e5ddd5;">
						</outline>
						<outline text="--header-bg: #075e54;">
						</outline>
						<outline text="--mine-bg:   #dcf8c6;">
						</outline>
						<outline text="--theirs-bg: #ffffff;">
						</outline>
						<outline text="--input-bg:  #f0f0f0;">
						</outline>
						<outline text="--send-bg:   #075e54;">
						</outline>
						<outline text="--text:      #111;">
						</outline>
						<outline text="--subtext:   #667781;">
						</outline>
						<outline text="--sender:    #1a9c7b;">
						</outline>
						<outline text="--tick:      #53bdeb;">
						</outline>
						<outline text="--radius:    18px;">
						</outline>
						<outline text="--shadow:    0 1px 2px rgba(0,0,0,.13);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divChat {">
						<outline text="width: 375px;">
						</outline>
						<outline text="height: 700px;">
						</outline>
						<outline text="background: var(--bg);">
						</outline>
						<outline text="border-radius: 36px;">
						</outline>
						<outline text="overflow: hidden;">
						</outline>
						<outline text="box-shadow: 0 24px 80px rgba(0,0,0,.4), inset 0 0 0 1px rgba(255,255,255,.15);">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="flex-direction: column;">
						</outline>
						<outline text="margin: 40px auto 0 auto;">
						</outline>
						<outline text="font-family: 'Inter', -apple-system, sans-serif;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divHeader {">
						<outline text="background: var(--header-bg);">
						</outline>
						<outline text="padding: 10px 12px;">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="align-items: center;">
						</outline>
						<outline text="gap: 10px;">
						</outline>
						<outline text="flex-shrink: 0;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBackArrow {">
						<outline text="color: white;">
						</outline>
						<outline text="font-size: 20px;">
						</outline>
						<outline text="cursor: pointer;">
						</outline>
						<outline text="padding-right: 2px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divAvatar {">
						<outline text="width: 38px;">
						</outline>
						<outline text="height: 38px;">
						</outline>
						<outline text="border-radius: 50%;">
						</outline>
						<outline text="background: #128c7e;">
						</outline>
						<outline text="color: white;">
						</outline>
						<outline text="font-size: 18px;">
						</outline>
						<outline text="font-weight: 600;">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="align-items: center;">
						</outline>
						<outline text="justify-content: center;">
						</outline>
						<outline text="flex-shrink: 0;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divHeaderInfo {">
						<outline text="flex: 1;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divHeaderName {">
						<outline text="color: white;">
						</outline>
						<outline text="font-size: 15px;">
						</outline>
						<outline text="font-weight: 600;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divHeaderStatus {">
						<outline text="color: rgba(255,255,255,.7);">
						</outline>
						<outline text="font-size: 12px;">
						</outline>
						<outline text="margin-top: 1px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divHeaderIcons {">
						<outline text="display: flex;">
						</outline>
						<outline text="gap: 16px;">
						</outline>
						<outline text="color: white;">
						</outline>
						<outline text="font-size: 18px;">
						</outline>
						<outline text="cursor: pointer;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divMessageContainer {">
						<outline text="flex: 1;">
						</outline>
						<outline text="overflow-y: auto;">
						</outline>
						<outline text="padding: 10px 8px;">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="flex-direction: column;">
						</outline>
						<outline text="gap: 2px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divMessageContainer::-webkit-scrollbar { width: 4px; }">
					</outline>
					<outline text=".divMessageContainer::-webkit-scrollbar-thumb { background: rgba(0,0,0,.2); border-radius: 2px; }">
					</outline>
					<outline text="">
					</outline>
					<outline text=".divDateDivider {">
						<outline text="text-align: center;">
						</outline>
						<outline text="margin: 8px 0;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divDateDivider span {">
						<outline text="background: rgba(255,255,255,.75);">
						</outline>
						<outline text="color: var(--subtext);">
						</outline>
						<outline text="font-size: 11.5px;">
						</outline>
						<outline text="padding: 3px 10px;">
						</outline>
						<outline text="border-radius: 8px;">
						</outline>
						<outline text="box-shadow: var(--shadow);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divThread {">
						<outline text="display: flex;">
						</outline>
						<outline text="flex-direction: column;">
						</outline>
						<outline text="width: 100%;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divThread + .divThread.mine   { margin-top: 1px; }">
					</outline>
					<outline text=".divThread + .divThread.theirs { margin-top: 1px; }">
					</outline>
					<outline text=".divThread.tail + .divThread   { margin-top: 4px; }">
					</outline>
					<outline text="">
					</outline>
					<outline text=".divReplies {">
						<outline text="display: flex;">
						</outline>
						<outline text="flex-direction: column;">
						</outline>
						<outline text="gap: 2px;">
						</outline>
						<outline text="padding-left: 24px;">
						</outline>
						<outline text="margin-top: 2px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divReplies:empty {">
						<outline text="display: none;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divBubble {">
						<outline text="max-width: 75%;">
						</outline>
						<outline text="padding: 6px 10px 4px 10px;">
						</outline>
						<outline text="border-radius: var(--radius);">
						</outline>
						<outline text="box-shadow: var(--shadow);">
						</outline>
						<outline text="position: relative;">
						</outline>
						<outline text="word-break: break-word;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBubble.mine {">
						<outline text="background: var(--mine-bg);">
						</outline>
						<outline text="align-self: flex-end;">
						</outline>
						<outline text="border-bottom-right-radius: 4px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBubble.theirs {">
						<outline text="background: var(--theirs-bg);">
						</outline>
						<outline text="align-self: flex-start;">
						</outline>
						<outline text="border-bottom-left-radius: 4px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBubble.noTail { border-radius: var(--radius); }">
					</outline>
					<outline text="">
					</outline>
					<outline text=".divSenderName {">
						<outline text="color: var(--sender);">
						</outline>
						<outline text="font-size: 12px;">
						</outline>
						<outline text="font-weight: 600;">
						</outline>
						<outline text="margin-bottom: 2px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBubbleText {">
						<outline text="color: var(--text);">
						</outline>
						<outline text="font-size: 14px;">
						</outline>
						<outline text="line-height: 1.4;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divBubbleMeta {">
						<outline text="display: flex;">
						</outline>
						<outline text="justify-content: flex-end;">
						</outline>
						<outline text="align-items: center;">
						</outline>
						<outline text="gap: 3px;">
						</outline>
						<outline text="margin-top: 2px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divTimestamp {">
						<outline text="color: var(--subtext);">
						</outline>
						<outline text="font-size: 11px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divTicks {">
						<outline text="color: var(--tick);">
						</outline>
						<outline text="font-size: 13px;">
						</outline>
						<outline text="line-height: 1;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".divInputBar {">
						<outline text="background: var(--input-bg);">
						</outline>
						<outline text="padding: 8px 10px;">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="align-items: center;">
						</outline>
						<outline text="gap: 8px;">
						</outline>
						<outline text="flex-shrink: 0;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divEmojiButton {">
						<outline text="font-size: 22px;">
						</outline>
						<outline text="cursor: pointer;">
						</outline>
						<outline text="flex-shrink: 0;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".editorInput {">
						<outline text="flex: 1;">
						</outline>
						<outline text="border: none;">
						</outline>
						<outline text="border-radius: 22px;">
						</outline>
						<outline text="padding: 9px 14px;">
						</outline>
						<outline text="font-size: 14.5px;">
						</outline>
						<outline text="font-family: inherit;">
						</outline>
						<outline text="background: white;">
						</outline>
						<outline text="outline: none;">
						</outline>
						<outline text="color: var(--text);">
						</outline>
						<outline text="box-shadow: var(--shadow);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".editorInput:disabled {">
						<outline text="background: #e0e0e0;">
						</outline>
						<outline text="color: #999;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text=".sendButton {">
						<outline text="width: 42px;">
						</outline>
						<outline text="height: 42px;">
						</outline>
						<outline text="border-radius: 50%;">
						</outline>
						<outline text="background: var(--send-bg);">
						</outline>
						<outline text="border: none;">
						</outline>
						<outline text="color: white;">
						</outline>
						<outline text="font-size: 18px;">
						</outline>
						<outline text="cursor: pointer;">
						</outline>
						<outline text="display: flex;">
						</outline>
						<outline text="align-items: center;">
						</outline>
						<outline text="justify-content: center;">
						</outline>
						<outline text="flex-shrink: 0;">
						</outline>
						<outline text="transition: background .15s;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".sendButton:hover { background: #128c7e; }">
					</outline>
				</outline>
				<outline text="chat.js" isComment="true">
					<outline text="function chatUserInterface (userOptions) { //4/29/26 by Claude + DW">
						<outline text="console.log (&quot;chatUserInterface&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var options = {">
							<outline text="whereToAppend: undefined, //i want the designer to tell us where it goes -- 4/29/26 by DW">
							</outline>
							<outline text="micIcon: &quot;&amp;#x1F3A4;&quot;, //microphone">
							</outline>
							<outline text="sendIcon: &quot;&amp;#x27A4;&quot;, //rightward arrow">
							</outline>
							<outline text="placeholderSignedIn: &quot;Message&quot;,">
							</outline>
							<outline text="placeholderSignedOut: &quot;Sign in to post&quot;,">
							</outline>
							<outline text="ctRecentItems: 100,">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="mergeOptions (userOptions, options);">
						</outline>
						<outline text="">
						</outline>
						<outline text="const divChat = $(&quot;&lt;div class=\&quot;divChat\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var getEditorText, clearEditor, setEditorEnabled; //assigned by getTextEditor">
						</outline>
						<outline text="var onEditorSubmit, onEditorInput; //callbacks assigned by chat constructor">
						</outline>
						<outline text="">
						</outline>
						<outline text="const sendButton = $(&quot;&lt;button class=\&quot;sendButton\&quot;&gt;&quot; + options.micIcon + &quot;&lt;/button&gt;&quot;);">
						</outline>
						<outline text="const divMessageContainer = $(&quot;&lt;div class=\&quot;divMessageContainer\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="const itemsById = {}; //look up parent bubble when an item with inReplyTo arrives">
						</outline>
						<outline text="">
						</outline>
						<outline text="var theLastFeedUrl = undefined;">
						</outline>
						<outline text="var theLastDateString = undefined;">
						</outline>
						<outline text="">
						</outline>
						<outline text="function getTimeString (theDate) {">
							<outline text="return (theDate.toLocaleTimeString ([], {hour: &quot;2-digit&quot;, minute: &quot;2-digit&quot;}));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getDateLabel (theDate) {">
							<outline text="const now = new Date ();">
							</outline>
							<outline text="const today = new Date (now.getFullYear (), now.getMonth (), now.getDate ());">
							</outline>
							<outline text="const dateOnly = new Date (theDate.getFullYear (), theDate.getMonth (), theDate.getDate ());">
							</outline>
							<outline text="const diffDays = (today - dateOnly) / 86400000;">
							</outline>
							<outline text="if (diffDays &lt; 1) {">
								<outline text="return (&quot;Today&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="if (diffDays &lt; 2) {">
								<outline text="return (&quot;Yesterday&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="return (theDate.toLocaleDateString ([], {month: &quot;long&quot;, day: &quot;numeric&quot;, year: &quot;numeric&quot;}));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function addItemToTimeline (item, flScroll) { //adds item to display">
							<outline text="const theDate = new Date (item.pubDate);">
							</outline>
							<outline text="const flMine = globals.myRssNetwork.userIsSignedIn () &amp;&amp; (item.feedUrl === globals.myRssNetwork.getFeedUrl ());">
							</outline>
							<outline text="const dateString = theDate.toDateString ();">
							</outline>
							<outline text="">
							</outline>
							<outline text="function getDateDivider () {">
								<outline text="const divDateDivider = $(&quot;&lt;div class=\&quot;divDateDivider\&quot;&gt;&lt;/div&gt;&quot;);">
								</outline>
								<outline text="const spanLabel = $(&quot;&lt;span&gt;&lt;/span&gt;&quot;).text (getDateLabel (theDate));">
								</outline>
								<outline text="divDateDivider.append (spanLabel);">
								</outline>
								<outline text="return (divDateDivider);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="function getSenderName () {">
								<outline text="const divSenderName = $(&quot;&lt;div class=\&quot;divSenderName\&quot;&gt;&lt;/div&gt;&quot;).text (item.author);">
								</outline>
								<outline text="return (divSenderName);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="function getBubbleText () {">
								<outline text="const divBubbleText = $(&quot;&lt;div class=\&quot;divBubbleText\&quot;&gt;&lt;/div&gt;&quot;).text (item.description);">
								</outline>
								<outline text="return (divBubbleText);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="function getBubbleMeta () {">
								<outline text="const divBubbleMeta = $(&quot;&lt;div class=\&quot;divBubbleMeta\&quot;&gt;&lt;/div&gt;&quot;);">
								</outline>
								<outline text="const spanTimestamp = $(&quot;&lt;span class=\&quot;divTimestamp\&quot;&gt;&quot; + getTimeString (theDate) + &quot;&lt;/span&gt;&quot;);">
								</outline>
								<outline text="divBubbleMeta.append (spanTimestamp);">
								</outline>
								<outline text="if (flMine) {">
									<outline text="const spanTicks = $(&quot;&lt;span class=\&quot;divTicks\&quot;&gt;&amp;#x2713;&amp;#x2713;&lt;/span&gt;&quot;); //double checkmark">
									</outline>
									<outline text="divBubbleMeta.append (spanTicks);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="return (divBubbleMeta);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="function getBubble (flTail) {">
								<outline text="const sideClass = flMine ? &quot;mine&quot; : &quot;theirs&quot;;">
								</outline>
								<outline text="const tailClass = flTail ? &quot;tail&quot; : &quot;noTail&quot;;">
								</outline>
								<outline text="const divBubble = $(&quot;&lt;div class=\&quot;divBubble &quot; + sideClass + &quot; &quot; + tailClass + &quot;\&quot;&gt;&lt;/div&gt;&quot;);">
								</outline>
								<outline text="if (!flMine &amp;&amp; flTail) {">
									<outline text="divBubble.append (getSenderName ());">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="divBubble.append (getBubbleText ());">
								</outline>
								<outline text="divBubble.append (getBubbleMeta ());">
								</outline>
								<outline text="return (divBubble);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="const parentEntry = (item.inReplyTo === undefined) ? undefined : itemsById [item.inReplyTo];">
							</outline>
							<outline text="var divParent, flTail;">
							</outline>
							<outline text="if (parentEntry === undefined) { //top-level item -- date divider, tail by feedUrl change, attach to message container">
								<outline text="if (dateString !== theLastDateString) {">
									<outline text="divMessageContainer.append (getDateDivider ());">
									</outline>
									<outline text="theLastDateString = dateString;">
									</outline>
									<outline text="theLastFeedUrl = undefined;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="flTail = (item.feedUrl !== theLastFeedUrl);">
								</outline>
								<outline text="theLastFeedUrl = item.feedUrl;">
								</outline>
								<outline text="divParent = divMessageContainer;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else { //reply -- always show sender, attach inside parent's divReplies">
								<outline text="flTail = true;">
								</outline>
								<outline text="divParent = parentEntry.divReplies;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const divBubble = getBubble (flTail);">
							</outline>
							<outline text="const divReplies = $(&quot;&lt;div class=\&quot;divReplies\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="divBubble.append (divReplies);">
							</outline>
							<outline text="divParent.append (divBubble);">
							</outline>
							<outline text="itemsById [item.id] = {divBubble, divReplies};">
							</outline>
							<outline text="">
							</outline>
							<outline text="if (flScroll) {">
								<outline text="divMessageContainer.scrollTop (divMessageContainer [0].scrollHeight);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function sendMessage () {">
							<outline text="console.log (&quot;sendMessage&quot;);">
							</outline>
							<outline text="const text = getEditorText ();">
							</outline>
							<outline text="if (text.length === 0) {">
								<outline text="return;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="if (!globals.myRssNetwork.userIsSignedIn ()) {">
								<outline text="return;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const item = {">
								<outline text="feedUrl: globals.myRssNetwork.getFeedUrl (),">
								</outline>
								<outline text="author: globals.myRssNetwork.getScreenname (),">
								</outline>
								<outline text="description: text,">
								</outline>
								<outline text="pubDate: new Date ().toISOString ()">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="if (appConsts.flPostItemsLocally) { //4/24/26 by DW">
								<outline text="addItemToTimeline (item, true);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="clearEditor ();">
							</outline>
							<outline text="sendButton.html (options.micIcon);">
							</outline>
							<outline text="const postRec = {">
								<outline text="description: text">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="globals.myRssNetwork.newPost (postRec, function (err, data) {">
								<outline text="if (err) {">
									<outline text="console.log (&quot;sendItem: err.message == &quot; + err.message);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function refresh () {">
							<outline text="setEditorEnabled (globals.myRssNetwork.userIsSignedIn ());">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function loadRecentItems () { //4/29/26 by DW">
							<outline text="globals.myRssNetwork.getRecentItems (options.ctRecentItems, function (err, theItems) {">
								<outline text="if (err) {">
									<outline text="console.log (&quot;loadRecentItems: err.message == &quot; + err.message);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="theItems.reverse (); //display oldest first, newest at bottom">
									</outline>
									<outline text="theItems.forEach (function (item) {">
										<outline text="addItemToTimeline (item, false);">
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="divMessageContainer.scrollTop (divMessageContainer [0].scrollHeight);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function getHeader () {">
							<outline text="const divHeader = $(&quot;&lt;div class=\&quot;divHeader\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const divBackArrow = $(&quot;&lt;div class=\&quot;divBackArrow\&quot;&gt;&amp;#x2190;&lt;/div&gt;&quot;); //leftwards arrow">
							</outline>
							<outline text="const divAvatar = $(&quot;&lt;div class=\&quot;divAvatar\&quot;&gt;r&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const divHeaderInfo = $(&quot;&lt;div class=\&quot;divHeaderInfo\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const divHeaderName = $(&quot;&lt;div class=\&quot;divHeaderName\&quot;&gt;rss.network&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const divHeaderStatus = $(&quot;&lt;div class=\&quot;divHeaderStatus\&quot;&gt;online&lt;/div&gt;&quot;);">
							</outline>
							<outline text="divHeaderInfo.append (divHeaderName);">
							</outline>
							<outline text="divHeaderInfo.append (divHeaderStatus);">
							</outline>
							<outline text="const divHeaderIcons = $(&quot;&lt;div class=\&quot;divHeaderIcons\&quot;&gt;&lt;span title=\&quot;More\&quot;&gt;&amp;#x22EE;&lt;/span&gt;&lt;/div&gt;&quot;); //vertical ellipsis">
							</outline>
							<outline text="divHeader.append (divBackArrow);">
							</outline>
							<outline text="divHeader.append (divAvatar);">
							</outline>
							<outline text="divHeader.append (divHeaderInfo);">
							</outline>
							<outline text="divHeader.append (divHeaderIcons);">
							</outline>
							<outline text="return (divHeader);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getTextEditor () {">
							<outline text="const divTextEditor = $(&quot;&lt;div class=\&quot;divTextEditor\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const editorInput = $(&quot;&lt;input type=\&quot;text\&quot; class=\&quot;editorInput\&quot; /&gt;&quot;);">
							</outline>
							<outline text="divTextEditor.append (editorInput);">
							</outline>
							<outline text="">
							</outline>
							<outline text="editorInput.on (&quot;input&quot;, function () {">
								<outline text="if (onEditorInput !== undefined) {">
									<outline text="onEditorInput ();">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="editorInput.on (&quot;keydown&quot;, function (event) {">
								<outline text="if (event.key === &quot;Enter&quot;) {">
									<outline text="if (onEditorSubmit !== undefined) {">
										<outline text="onEditorSubmit ();">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="getEditorText = function () {">
								<outline text="return (editorInput.val ().trim ());">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="clearEditor = function () {">
								<outline text="editorInput.val (&quot;&quot;);">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="setEditorEnabled = function (flBool) {">
								<outline text="if (flBool) {">
									<outline text="editorInput.prop (&quot;disabled&quot;, false);">
									</outline>
									<outline text="editorInput.attr (&quot;placeholder&quot;, options.placeholderSignedIn);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="editorInput.prop (&quot;disabled&quot;, true);">
									</outline>
									<outline text="editorInput.attr (&quot;placeholder&quot;, options.placeholderSignedOut);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="return (divTextEditor);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getInputBar () {">
							<outline text="const divInputBar = $(&quot;&lt;div class=\&quot;divInputBar\&quot;&gt;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="const divEmojiButton = $(&quot;&lt;div class=\&quot;divEmojiButton\&quot;&gt;&amp;#x1F642;&lt;/div&gt;&quot;); //slightly smiling face">
							</outline>
							<outline text="divInputBar.append (divEmojiButton);">
							</outline>
							<outline text="divInputBar.append (getTextEditor ());">
							</outline>
							<outline text="divInputBar.append (sendButton);">
							</outline>
							<outline text="return (divInputBar);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="divChat.append (getHeader ());">
						</outline>
						<outline text="divChat.append (divMessageContainer);">
						</outline>
						<outline text="divChat.append (getInputBar ());">
						</outline>
						<outline text="options.whereToAppend.append (divChat);">
						</outline>
						<outline text="">
						</outline>
						<outline text="onEditorInput = function () {">
							<outline text="sendButton.html (getEditorText () ? options.sendIcon : options.micIcon);">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="onEditorSubmit = sendMessage;">
						</outline>
						<outline text="sendButton.on (&quot;click&quot;, function () {">
							<outline text="if (getEditorText ()) {">
								<outline text="sendMessage ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="refresh ();">
						</outline>
						<outline text="loadRecentItems (); //4/29/26 by DW">
						</outline>
						<outline text="">
						</outline>
						<outline text="this.newItem = function (item) {">
							<outline text="console.log (&quot;chatUserInterface.newItem&quot;);">
							</outline>
							<outline text="addItemToTimeline (item, true);">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="this.refresh = refresh;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="signupdialog.css" isComment="true">
					<outline text=".divSignupDialog {">
						<outline text="left: 50%;">
						</outline>
						<outline text="width: 570px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .inputForName {">
						<outline text="font-size: 17px;">
						</outline>
						<outline text="padding: 3px;">
						</outline>
						<outline text="width: 10em;">
						</outline>
						<outline text="height: auto;">
						</outline>
						<outline text="border: 1px solid green;" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .xlarge {">
						<outline text="font-size: 16px;">
						</outline>
						<outline text="height: auto;">
						</outline>
						<outline text="margin-bottom: 0;">
						</outline>
						<outline text="width: 150px;" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .divPreamble {">
						<outline text="font-size: 15px;">
						</outline>
						<outline text="margin-bottom: 20px;">
						</outline>
						<outline text="text-align: center;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .modal-footer {">
						<outline text="margin-top: 10px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .spComment {">
						<outline text="font-size: 13px;">
						</outline>
						<outline text="margin-left: 3px;">
						</outline>
						<outline text="opacity: .5;">
						</outline>
						<outline text="color: green;" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog .commentIsError {">
						<outline text="color: red;" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text=".divSignupDialog h3 {">
						<outline text="font-size: 18px;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="signupdialog.js" isComment="true">
					<outline text="function signupDialog (userOptions) {">
						<outline text="Changes" isComment="true">
							<outline text="6/17/26; 3:26:52 PM by DW">
								<outline text="Modified so it can be called from rssNetwork app. ">
									<outline text="options.canCreateAccountCallback is new -- it's there for the whitelist code">
										<outline text="returns an error if you can't create it. ">
										</outline>
									</outline>
									<outline text="options.extraLegalChars is an array, if one of those chars comes in, we accept it">
									</outline>
								</outline>
							</outline>
							<outline text="4/4/22; 10:55:51 AM by DW">
								<outline text="The ask dialog as a closure. Here's the HTML we construct (at start).">
									<outline text="&lt;div class=&quot;divAskDialog&quot; style=&quot;left: 50%; width: 570px;&quot;&gt;" isComment="true">
										<outline text="&lt;div id=&quot;idAskDialog&quot; class=&quot;modal hide fade&quot; tabindex=&quot;-1&quot; role=&quot;dialog&quot; aria-labelledby=&quot;windowTitleLabel&quot; aria-hidden=&quot;true&quot;&gt;">
											<outline text="&lt;div class=&quot;modal-header&quot;&gt;">
												<outline text="&lt;a href=&quot;#&quot; class=&quot;close&quot; data-dismiss=&quot;modal&quot;&gt;&amp;times;&lt;/a&gt;">
												</outline>
												<outline text="&lt;h3 id=&quot;idAskDialogPrompt&quot; style=&quot;font-size: 18px;&quot;&gt;&lt;/h3&gt;">
												</outline>
												<outline text="&lt;/div&gt;">
												</outline>
											</outline>
											<outline text="&lt;div class=&quot;modal-body&quot;&gt;">
												<outline text="&lt;input class=&quot;xlarge&quot; id=&quot;idAskDialogInput&quot; name=&quot;xlInput&quot; type=&quot;text&quot; style=&quot;font-size: 17px; padding: 3px; height: auto; width: 515px;&quot; /&gt;">
												</outline>
												<outline text="&lt;/div&gt;">
												</outline>
											</outline>
											<outline text="&lt;div class=&quot;modal-footer&quot;&gt;">
												<outline text="&lt;a href=&quot;#&quot; class=&quot;btn&quot; onclick=&quot;cancelAskDialog ();&quot; style=&quot;width: 80px; margin-left: 5px;&quot;&gt;Cancel&lt;/a&gt;">
												</outline>
												<outline text="&lt;a href=&quot;#&quot; class=&quot;btn btn-primary&quot; onclick=&quot;okAskDialog ();&quot; style=&quot;width: 80px; margin-left: 5px;&quot;&gt;OK&lt;/a&gt;">
												</outline>
												<outline text="&lt;/div&gt;">
												</outline>
											</outline>
											<outline text="&lt;/div&gt;">
											</outline>
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
								</outline>
							</outline>
						</outline>
						<outline text="function getSavedValue (theValue) {">
							<outline text="const val = (theValue === undefined) ? &quot;&quot; : theValue;">
							</outline>
							<outline text="return (val);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="var options = {">
							<outline text="prompt: &quot;Choose a name and enter your email address.&quot;,">
							</outline>
							<outline text="preamble: &quot;When you're ready, click the Send button to get a confirming email.&quot;,">
							</outline>
							<outline text="preamble: &quot;We'll explain something interesting that helps people get the idea.&quot;," isComment="true">
							</outline>
							<outline text="">
							</outline>
							<outline text="defaultNameValue: getSavedValue (localStorage.signupName),">
							</outline>
							<outline text="placeholderForName: &quot;1. Choose a name&quot;,">
							</outline>
							<outline text="minNameLength: 4,">
							</outline>
							<outline text="">
							</outline>
							<outline text="defaultEmailValue: getSavedValue (localStorage.signupEmail),">
							</outline>
							<outline text="placeholderForEmail: &quot;2. Enter your email address&quot;,">
							</outline>
							<outline text="canCreateAccountCallback: function (email, name, callback) { //6/18/26 by DW">
								<outline text="callback (true);">
								</outline>
								<outline text="},">
								</outline>
							</outline>
							<outline text="extraLegalChars: new Array (), //6/18/26 by DW">
							</outline>
							<outline text="callback: function () {">
								<outline text="},">
								</outline>
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="mergeOptions (userOptions, options); //6/17/26 by DW">
						</outline>
						<outline text="if (userOptions !== undefined) {" isComment="true">
							<outline text="for (var x in userOptions) {">
								<outline text="options [x] = userOptions [x];">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function closeDialog () {">
							<outline text="$(theDialog).modal (&quot;hide&quot;); ">
							</outline>
							<outline text="$(theDialog).on (&quot;hidden.bs.modal&quot;, function () { //code that runs when dialog has finished being hidden">
								<outline text="$(theDialogContainer).remove ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function cancelDialog () {">
							<outline text="options.callback (&quot;&quot;, true); ">
							</outline>
							<outline text="closeDialog ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function okDialog () { //ok button was clicked">
							<outline text="var val = theNameElement.val ();">
							</outline>
							<outline text="options.callback (val, false); ">
							</outline>
							<outline text="closeDialog ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getCloseIcon () {">
							<outline text="var theIcon = $(&quot;&lt;a href=\&quot;#\&quot; class=\&quot;close\&quot; data-dismiss=\&quot;modal\&quot;&gt;&amp;times;&lt;/a&gt;&quot;);">
							</outline>
							<outline text="$(theIcon).click (cancelDialog);">
							</outline>
							<outline text="return (theIcon);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getPrompt () {">
							<outline text="var thePrompt = $(&quot;&lt;h3&gt;&quot; + options.prompt + &quot;&lt;/h3&gt;&quot;);">
							</outline>
							<outline text="return (thePrompt);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function setComment (obj, theComment, flIsError) {">
							<outline text="obj.html (theComment);">
							</outline>
							<outline text="if (flIsError) {">
								<outline text="obj.addClass (&quot;commentIsError&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="obj.removeClass (&quot;commentIsError&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function setNameComment () {">
							<outline text="Changes" isComment="true">
								<outline text="6/17/26; 4:15:51 PM by DW">
									<outline text="They can also contain periods.">
									</outline>
								</outline>
								<outline text="3/17/23; 11:48:27 AM by DW">
									<outline text="Names can only contain alpha, numeric and underscore characters.">
									</outline>
								</outline>
							</outline>
							<outline text="var name = theNameElement.val ();">
							</outline>
							<outline text="function containsIllegalCharacter (name) {">
								<outline text="function isLegal (ch) {">
									<outline text="if (options.extraLegalChars.includes (ch)) {">
										<outline text="return (true);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="return (isAlpha (ch) || isNumeric (ch) || (ch == &quot;_&quot;));">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="for (var i = 0; i &lt; name.length; i++) {">
									<outline text="let ch = name [i];">
									</outline>
									<outline text="if (!isLegal (ch)) {">
										<outline text="return (true);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="return (false);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="if (containsIllegalCharacter (name)) {">
								<outline text="setComment (theNameComment, &quot;Character not allowed.&quot;, true);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="if (name.length &lt; options.minNameLength) {">
									<outline text="setComment (theNameComment, &quot;Name must be &quot; + options.minNameLength + &quot; chars.&quot;, true);">
									</outline>
									<outline text="theNameComment.html (&quot;Name must be &quot; + options.minNameLength + &quot; chars.&quot;);" isComment="true">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="isUserInDatabase (name, function (flInDatabase) {">
										<outline text="var comment;">
										</outline>
										<outline text="if (flInDatabase) {">
											<outline text="setComment (theNameComment, name + &quot; is in use.&quot;, true);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="setComment (theNameComment, name + &quot; ok.&quot;, false);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getNameElement () {">
							<outline text="var namebox = $(&quot;&lt;input class=\&quot;xlarge\&quot; type=\&quot;text\&quot;&gt;&quot;);">
							</outline>
							<outline text="if (options.defaultNameValue.length &gt; 0) {">
								<outline text="namebox.attr (&quot;value&quot;, options.defaultNameValue);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="namebox.width (175);">
							</outline>
							<outline text="namebox.attr (&quot;placeholder&quot;, options.placeholderForName);">
							</outline>
							<outline text="namebox.attr (&quot;spellcheck&quot;, false);">
							</outline>
							<outline text="namebox.keyup (function (ev) {">
								<outline text="setNameComment ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="setTimeout (setComment, 10);" isComment="true">
							</outline>
							<outline text="return (namebox);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function setEmailComment () {">
							<outline text="var email = theEmailElement.val ();">
							</outline>
							<outline text="if (stringContains (email, &quot;@&quot;)) {">
								<outline text="var domain = stringNthField (email, &quot;@&quot;, 2);">
								</outline>
								<outline text="if (stringContains (domain, &quot;.&quot;)) {">
									<outline text="isEmailInDatabase (email, function (flInDatabase) {">
										<outline text="var comment;">
										</outline>
										<outline text="if (flInDatabase) {">
											<outline text="setComment (theEmailComment, email + &quot; in use.&quot;, true);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="setComment (theEmailComment, email + &quot; ok.&quot;, false);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="setComment (theEmailComment, &quot;Email address domain must contain a period.&quot;, true);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="theEmailComment.html (&quot;Email address must contain an @ sign.&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getEmailElement () {">
							<outline text="emailbox = $(&quot;&lt;input class=\&quot;xlarge\&quot; type=\&quot;text\&quot;&gt;&quot;);">
							</outline>
							<outline text="if (options.defaultEmailValue.length &gt; 0) {">
								<outline text="emailbox.attr (&quot;value&quot;, options.defaultEmailValue);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="emailbox.width (340);">
							</outline>
							<outline text="emailbox.css (&quot;margin-left&quot;, 7);">
							</outline>
							<outline text="emailbox.attr (&quot;placeholder&quot;, options.placeholderForEmail);">
							</outline>
							<outline text="emailbox.attr (&quot;spellcheck&quot;, false);">
							</outline>
							<outline text="emailbox.keyup (function (ev) {">
								<outline text="console.log (&quot;emailbox: ev.which == &quot; + ev.which);" isComment="true">
								</outline>
								<outline text="setEmailComment ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="return (emailbox);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getNameComment () {">
							<outline text="var theComment = $(&quot;&lt;span class=\&quot;spComment\&quot;&gt;&lt;/span&gt;&quot;);">
							</outline>
							<outline text="theComment.width (175);" isComment="true">
							</outline>
							<outline text="theComment.css (&quot;min-width&quot;, 175);" isComment="true">
							</outline>
							<outline text="return (theComment);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getEmailComment () {">
							<outline text="var theComment = $(&quot;&lt;span class=\&quot;spComment\&quot;&gt;&lt;/span&gt;&quot;);">
							</outline>
							<outline text="theComment.width (345);" isComment="true">
							</outline>
							<outline text="theComment.css (&quot;margin-left&quot;, 13);">
							</outline>
							<outline text="return (theComment);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getCancelButton () {">
							<outline text="var theButton = $(&quot;&lt;a href=\&quot;#\&quot; class=\&quot;btn\&quot; style=\&quot;width: 80px; margin-left: 5px;\&quot;&gt;Cancel&lt;/a&gt;&quot;);">
							</outline>
							<outline text="$(theButton).click (cancelDialog);">
							</outline>
							<outline text="return (theButton);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getSendButton () {">
							<outline text="var theButton = $(&quot;&lt;a href=\&quot;#\&quot; class=\&quot;btn btn-primary\&quot; style=\&quot;width: 80px; margin-left: 5px;\&quot;&gt;Send&lt;/a&gt;&quot;);">
							</outline>
							<outline text="$(theButton).click (function (ev) {">
								<outline text="var email = theEmailElement.val ();">
								</outline>
								<outline text="var name = theNameElement.val ();">
								</outline>
								<outline text="">
								</outline>
								<outline text="localStorage.signupEmail = email; //1/12/23 by DW">
								</outline>
								<outline text="localStorage.signupName = name; //1/12/23 by DW">
								</outline>
								<outline text="">
								</outline>
								<outline text="options.canCreateAccountCallback (email, name, function (err) { //6/18/26 by DW">
									<outline text="if (err) {">
										<outline text="alertDialog (err.message);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="createNewUser (email, name, function (err, data) {">
											<outline text="if (err) {">
												<outline text="alertDialog (err.message);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="else {">
												<outline text="alertDialog (&quot;Please check your email.&quot;);">
												</outline>
												<outline text="console.log (data);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="});">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="">
								</outline>
								<outline text="">
								</outline>
								<outline text="closeDialog ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="return (theButton);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getSendButton () {" isComment="true">
							<outline text="var theButton = $(&quot;&lt;a href=\&quot;#\&quot; class=\&quot;btn btn-primary\&quot; style=\&quot;width: 80px; margin-left: 5px;\&quot;&gt;Send&lt;/a&gt;&quot;);">
							</outline>
							<outline text="$(theButton).click (function (ev) {">
								<outline text="var email = theEmailElement.val ();">
								</outline>
								<outline text="var name = theNameElement.val ();">
								</outline>
								<outline text="">
								</outline>
								<outline text="localStorage.signupEmail = email; //1/12/23 by DW">
								</outline>
								<outline text="localStorage.signupName = name; //1/12/23 by DW">
								</outline>
								<outline text="">
								</outline>
								<outline text="createNewUser (email, name, function (err, data) {">
									<outline text="if (err) {">
										<outline text="alertDialog (err.message);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="alertDialog (&quot;Please check your email.&quot;);">
										</outline>
										<outline text="console.log (data);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="closeDialog ();">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="return (theButton);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function getPreamble () {">
							<outline text="var preamble = $(&quot;&lt;div class=\&quot;divPreamble\&quot;&gt;&quot; + options.preamble + &quot;&lt;/div&gt;&quot;);">
							</outline>
							<outline text="return (preamble);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="console.log (&quot;signupDialog&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var theDialogContainer = $(&quot;&lt;div class=\&quot;divSignupDialog\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="var theDialog = $(&quot;&lt;div class=\&quot;modal hide fade\&quot; tabindex=\&quot;-1\&quot; role=\&quot;dialog\&quot; aria-labelledby=\&quot;windowTitleLabel\&quot; aria-hidden=\&quot;true\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var theHeader = $(&quot;&lt;div class=\&quot;modal-header\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="$(theHeader).append (getCloseIcon ());">
						</outline>
						<outline text="$(theHeader).append (getPrompt ());">
						</outline>
						<outline text="$(theDialog).append (theHeader);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var theBody = $(&quot;&lt;div class=\&quot;modal-body\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="$(theDialog).append (theBody);">
						</outline>
						<outline text="">
						</outline>
						<outline text="theBody.append (getPreamble ());">
						</outline>
						<outline text="">
						</outline>
						<outline text="//set up the table containing the input items and the comments">
							<outline text="var theTable = $(&quot;&lt;table&gt;&lt;/table&gt;&quot;);">
							</outline>
							<outline text="var inputRow = $(&quot;&lt;tr&gt;&lt;/tr&gt;&quot;);">
							</outline>
							<outline text="theTable.append (inputRow);">
							</outline>
							<outline text="">
							</outline>
							<outline text="var theNameElement = getNameElement (); ">
							</outline>
							<outline text="var nameTd = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="nameTd.append (theNameElement);">
							</outline>
							<outline text="inputRow.append (nameTd);">
							</outline>
							<outline text="">
							</outline>
							<outline text="var theEmailElement = getEmailElement (); ">
							</outline>
							<outline text="var emailTd = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="emailTd.append (theEmailElement);">
							</outline>
							<outline text="inputRow.append (emailTd);">
							</outline>
							<outline text="">
							</outline>
							<outline text="var commentRow = $(&quot;&lt;tr&gt;&lt;/tr&gt;&quot;);">
							</outline>
							<outline text="theTable.append (commentRow);">
							</outline>
							<outline text="">
							</outline>
							<outline text="var theNameComment = getNameComment ();">
							</outline>
							<outline text="var nameCommentTd = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="nameCommentTd.append (theNameComment);">
							</outline>
							<outline text="commentRow.append (nameCommentTd);">
							</outline>
							<outline text="">
							</outline>
							<outline text="var theEmailComment = getEmailComment ();">
							</outline>
							<outline text="var emailCommentTd = $(&quot;&lt;td&gt;&lt;/td&gt;&quot;);">
							</outline>
							<outline text="emailCommentTd.append (theEmailComment);">
							</outline>
							<outline text="commentRow.append (emailCommentTd);">
							</outline>
							<outline text="">
							</outline>
							<outline text="setNameComment ();">
							</outline>
							<outline text="setEmailComment ()">
							</outline>
							<outline text="">
							</outline>
							<outline text="theBody.append (theTable);">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="var theFooter = $(&quot;&lt;div class=\&quot;modal-footer\&quot;&gt;&lt;/div&gt;&quot;);">
						</outline>
						<outline text="$(theFooter).append (getCancelButton ());">
						</outline>
						<outline text="$(theFooter).append (getSendButton ());">
						</outline>
						<outline text="$(theDialog).append (theFooter);">
						</outline>
						<outline text="">
						</outline>
						<outline text="$(theDialogContainer).append (theDialog);">
						</outline>
						<outline text="$(&quot;body&quot;).prepend (theDialogContainer);">
						</outline>
						<outline text="$(theDialog).modal (&quot;show&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="$(theDialog).on (&quot;shown&quot;, function () {">
							<outline text="console.log (&quot;shown event&quot;);" isComment="true">
							</outline>
							<outline text="theNameElement.focus ();">
							</outline>
							<outline text="theNameElement.select ();">
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="$(theDialog).on (&quot;keydown&quot;, function (ev) { ">
							<outline text="console.log (&quot;askDialog: ev.which == &quot; + ev.which);" isComment="true">
							</outline>
							<outline text="if (ev.which == 13) {">
								<outline text="console.log (&quot;you pressed return&quot;);" isComment="true">
								</outline>
								<outline text="okDialog ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="settingsarchive.opml" isComment="true">
					<outline text="CSS">
						<outline text="&lt;%prefs.checkboxPref (&quot;Apply this CSS code at startup.&quot;, &quot;flApplyUserCss&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.textAreaPref (&quot;CSS&quot;, &quot;userCss&quot;, &quot;These styles will be inserted when the app starts up, if the checkbox above is checked. If you want to start over, delete all the text and save.&quot;, 70, 10)%&gt;">
						</outline>
					</outline>
					<outline text="&lt;%prefs.stringPref (&quot;If signed out&quot;, &quot;placeholderSignedOut&quot;, &quot;Sign in to post&quot;)%&gt;">
					</outline>
					<outline text="Domain">
						<outline text="&lt;%prefs.stringPref (&quot;Domain&quot;, &quot;myFeedDomain&quot;, &quot;A domain you control that you want to associate with your feed.&quot;)%&gt;">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="Basics">
					</outline>
					<outline text="">
					</outline>
					<outline text="">
					</outline>
					<outline text="Basics">
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm new posts.&quot;, &quot;flConfirmNewPosts&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm before publishing.&quot;, &quot;flConfirmPublish&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm after first publish.&quot;, &quot;flConfirmAfterFirstPublish&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Confirm linkblog posts.&quot;, &quot;flConfirmLinkblogPosts&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Audible icon clicks.&quot;, &quot;flAudibleIconClicks&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Bookmarks menu.&quot;, &quot;flBookmarksMenu&quot;)%&gt;">
						</outline>
						<outline text="&lt;%prefs.checkboxPref (&quot;Close editor after publish.&quot;, &quot;flCloseEditorAfterPublish&quot;)%&gt;">
						</outline>
					</outline>
					<outline text="CSS">
					</outline>
					<outline text="AI code">
						<outline text="&lt;%prefs.textAreaPref (&quot;AI prompt&quot;, &quot;aiPrompt&quot;, &quot;Enter your initial instructions for your AI system.&quot;, 70, 15)%&gt;">
						</outline>
					</outline>
				</outline>
			</outline>
			<outline text="readme.md">
				<outline text="# rss.chat">
					<outline text="A simple chat app based on RSS and other standard web technologies...">
					</outline>
				</outline>
			</outline>
		</outline>
		<outline text="build script">
			<outline text="nodeEditorSuite.utilities.buildRssChat ()">
			</outline>
		</outline>
		</body>
	</opml>

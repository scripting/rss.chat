				<outline text="">
				</outline>
				<outline text="const leftColumnIcons = [ //5/20/26 by DW">
					<outline text="{ //home">
						<outline text="name: &quot;home&quot;,">
						</outline>
						<outline text="title: &quot;Home&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-home\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Click to go to the back to the timeline.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function () {">
							<outline text="clickHomeButton (); //6/19/26 by DW">
							</outline>
							<outline text="alertDialog (&quot;I have no idea what the Home button does but i want it to do something.&quot;);" isComment="true">
							</outline>
							<outline text="opFirstSummit ();" isComment="true">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //big plus">
						<outline text="name: &quot;bigPlus&quot;,">
						</outline>
						<outline text="title: &quot;New post&quot;,">
						</outline>
						<outline text="icon: `&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;24&quot; height=&quot;24&quot; viewBox=&quot;0 0 16 16&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;3.5&quot; stroke-linecap=&quot;round&quot;&gt;">
							<outline text="&lt;line x1=&quot;8&quot; y1=&quot;3&quot; x2=&quot;8&quot; y2=&quot;13&quot; /&gt;">
							</outline>
							<outline text="&lt;line x1=&quot;3&quot; y1=&quot;8&quot; x2=&quot;13&quot; y2=&quot;8&quot; /&gt;">
							</outline>
							<outline text="&lt;/svg&gt;">
							</outline>
							<outline text="`,">
							</outline>
						</outline>
						<outline text="tooltip: &quot;Add new post.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function () {">
							<outline text="globals.myChatUserInterface.editNewItem (); //5/20/26 by DW">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //feed">
						<outline text="name: &quot;feed&quot;,">
						</outline>
						<outline text="title: &quot;Your feed&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-rss\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;View your &quot; + appConsts.productNameForDisplay + &quot; feed.&quot;,">
						</outline>
						<outline text="enabled: true,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="viewMyFeedCommand ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //view data">
						<outline text="name: &quot;data&quot;,">
						</outline>
						<outline text="title: &quot;Your prefs&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-code\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;View your prefs in JSON.&quot;,">
						</outline>
						<outline text="enabled: true,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="viewPrefsData ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="{ //surface" isComment="true">
						<outline text="name: &quot;surface&quot;,">
						</outline>
						<outline text="title: &quot;Surface&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-level-up-alt\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Pop out to the timeline with cursor preserved.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function () {">
							<outline text="console.log (&quot;surface&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.surface (); //7/10/26 by DW">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //flipswitch" isComment="true">
						<outline text="name: &quot;flipswitch&quot;,">
						</outline>
						<outline text="title: &quot;Flip&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-paw\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Flip from timeline to structure and back.&quot;,">
						</outline>
						<outline text="enabled: true,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;flipswitch&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.flipView ();">
							</outline>
							<outline text="enableIcons ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //edit" isComment="true">
						<outline text="name: &quot;pen&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-pen\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Edit this post.&quot;,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;click&quot;);">
							</outline>
							<outline text="if (options.theDraft === undefined) { //4/8/26 by DW">
								<outline text="speakerBeep ();">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="myChatlog.openDraft (options.theDraft.id, options.theDraft); ">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="myWordpress.getWordlandDraft (options.inReplyTo.idSite, options.inReplyTo.idPost, function (err, theDraft) {" isComment="true">
								<outline text="if (err) {">
									<outline text="console.log (&quot;getWordlandDraft: err.message == &quot; + err.message);">
									</outline>
									<outline text="speakerBeep ();">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="myChatlog.openDraft (theDraft.id, theDraft); ">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="ev.stopPropagation (); ">
							</outline>
							<outline text="ev.preventDefault (); ">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //comment" isComment="true">
						<outline text="name: &quot;comment&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;far fa-comment fa-comment\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Write a comment.&quot;,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;click&quot;);">
							</outline>
							<outline text="const params = {">
								<outline text="title: options.inReplyTo.title,">
								</outline>
								<outline text="idSite: options.inReplyTo.idSite,">
								</outline>
								<outline text="idPost: options.inReplyTo.idPost,">
								</outline>
								<outline text="urlPost: &quot;hello world&quot;">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="const params = {" isComment="true">
								<outline text="title: options.atts.title,">
								</outline>
								<outline text="idSite: options.atts.wpSiteId,">
								</outline>
								<outline text="idPost: options.atts.wpPostId,">
								</outline>
								<outline text="urlPost: options.atts.link">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="if (params.idSite === undefined) { //1/12/26 by DW">
								<outline text="alertDialog (&quot;Can't reply to this post because it's not on a WordPress site.&quot;);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="newCommentCommand (params);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //hoist" isComment="true">
						<outline text="name: &quot;hoist&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-thumbtack\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Hoist: Focus on the current item.&quot;,">
						</outline>
						<outline text="enabled: true,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;hoist&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.hoist ();">
							</outline>
							<outline text="enableIcons (); ">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //dehoist" isComment="true">
						<outline text="name: &quot;dehoist&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-thumbtack fa-rotate-180\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Dehoist: Undo the last hoist.&quot;,">
						</outline>
						<outline text="enabled: true,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;dehoist&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.dehoist ();">
							</outline>
							<outline text="enableIcons (); ">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //eye icon" isComment="true">
						<outline text="name: &quot;eye&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-eye\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Read this post on the web.&quot;,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;clickEyeIcon: options.inReplyTo.url == &quot; + options.inReplyTo.url);">
							</outline>
							<outline text="window.open (options.inReplyTo.url);">
							</outline>
							<outline text="" isComment="true">
							</outline>
							<outline text="myWordpress.getPost (options.inReplyTo.idSite, options.inReplyTo.idPost, function (err, thePost) {" isComment="true">
								<outline text="if (err) {">
									<outline text="console.log (&quot;getEyeIcon: err.message == &quot; + err.message);">
									</outline>
									<outline text="speakerBeep ();">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="console.log (&quot;getEyeIcon: thePost == &quot; + jsonStringify (thePost));">
									</outline>
									<outline text="window.open (thePost.url);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //palette" isComment="true">
						<outline text="icon: &quot;&lt;i class=\&quot;fa-solid fa-text-height\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa-solid fa-palette\&quot;&gt;&lt;/i&gt;&quot;," isComment="true">
						</outline>
						<outline text="tooltip: &quot;Set font size.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="viewSizesDialog (); //2/4/26 by DW">
							</outline>
							<outline text="viewColorsDialog (); //9/30/25 by DW" isComment="true">
							</outline>
							<outline text="viewCustomerizersDialog ();" isComment="true">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //OG metadata" isComment="true">
						<outline text="icon: &quot;&lt;i class=\&quot;fa-solid fa-image-portrait\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;View OG metadata for current item.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="viewOgMetadataForCurrentItem ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //checkboxes" isComment="true">
						<outline text="icon: &quot;&lt;i class=\&quot;fa-solid fa-list-check\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Checkboxes for which feeds are visible.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="viewSiteCheckboxesDialog ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //mailbox flag 1/12/26 by DW" isComment="true">
						<outline text="icon: `">
							<outline text="&lt;svg">
								<outline text="xmlns=&quot;http://www.w3.org/2000/svg&quot;">
								</outline>
								<outline text="viewBox=&quot;0 0 16 20&quot;">
								</outline>
								<outline text="width=&quot;16&quot;">
								</outline>
								<outline text="height=&quot;20&quot;">
								</outline>
								<outline text="style=&quot;shape-rendering: crispEdges;&quot;">
								</outline>
								<outline text="fill=&quot;currentColor&quot;&gt;">
								</outline>
								<outline text="&lt;!--">
									<outline text="Mailbox flag icon based on the original Macintosh">
									</outline>
									<outline text="Alarm Desk Accessory (System 1, 1984).">
									</outline>
									<outline text="Icon design by Susan Kare.">
									</outline>
									<outline text="Pixel-faithful SVG transcription, reproduced">
									</outline>
									<outline text="with credit and respect for the original work.">
									</outline>
									<outline text="--&gt;">
									</outline>
								</outline>
								<outline text="&lt;rect x=&quot;6&quot; y=&quot;1&quot; width=&quot;2&quot; height=&quot;18&quot;/&gt;">
								</outline>
								<outline text="&lt;rect x=&quot;4&quot; y=&quot;5&quot; width=&quot;6&quot; height=&quot;6&quot;/&gt;">
								</outline>
								<outline text="&lt;rect x=&quot;6&quot; y=&quot;7&quot; width=&quot;2&quot; height=&quot;2&quot; fill=&quot;white&quot;/&gt;">
								</outline>
								<outline text="&lt;rect x=&quot;8&quot; y=&quot;2&quot; width=&quot;6&quot; height=&quot;5&quot;/&gt;">
								</outline>
								<outline text="&lt;/svg&gt;">
								</outline>
							</outline>
							<outline text="`,">
							</outline>
						</outline>
						<outline text="tooltip: &quot;The flag down icon.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="console.log (&quot;mailbox flag click&quot;)">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //expand-collapse" isComment="true">
						<outline text="icon: `&lt;svg width=&quot;36&quot; height=&quot;36&quot; viewBox=&quot;0 0 256 256&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot; focusable=&quot;false&quot;&gt;">
							<outline text="&lt;path d=&quot;M96 48 L176 128 L96 208 Z&quot; fill=&quot;currentColor&quot;/&gt;">
							</outline>
							<outline text="&lt;/svg&gt;">
							</outline>
							<outline text="`,">
							</outline>
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-caret-right\&quot;&gt;&lt;/i&gt;&quot;," isComment="true">
						</outline>
						<outline text="tooltip: &quot;Expand or collapse.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="timelineExpandToggle ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //arrowpad //1/14/26 by DW" isComment="true">
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-arrows\&quot; id=\&quot;idArrowPadIcon\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Open the arrow pad.&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="toggleArrowPad ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //user" isComment="true">
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-user\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="click: function () {">
							<outline text="viewSizesDialog (); //9/30/25 by DW">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="];">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="const insideItemIcons = [ //5/22/26 by DW">
					<outline text="{ //comment">
						<outline text="name: &quot;comment&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;far fa-comment fa-comment\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Write a comment.&quot;," isComment="true">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Write a reply to this post.&quot;,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;comment&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.editNewComment (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //heart icon -- 6/25/26 by DW">
						<outline text="name: &quot;like&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;far fa-heart\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;like&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.toggleLike (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //pencil icon">
						<outline text="name: &quot;pencil&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-edit\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-pen\&quot;&gt;&lt;/i&gt;&quot;," isComment="true">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Edit this post.&quot;,">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;pencil&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.editItem (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //eye icon" isComment="true">
						<outline text="name: &quot;eye&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-eye\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Read this post on the web.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="clickEyeIcon (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //view data">
						<outline text="name: &quot;data&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fa fa-code\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;View data for this item.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="viewItemData (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //delete" isComment="true">
						<outline text="name: &quot;trashcan&quot;,">
						</outline>
						<outline text="icon: &quot;&lt;i class=\&quot;fas fa-trash\&quot;&gt;&lt;/i&gt;&quot;,">
						</outline>
						<outline text="tooltip: &quot;Delete this post.&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;delete: ev.item == &quot; + jsonStringify (ev.item));">
							</outline>
							<outline text="deletePostCommand (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="]">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="const editorMenu = [ //6/10/26 by DW">
					<outline text="{ //set title">
						<outline text="name: &quot;setTitle&quot;,">
						</outline>
						<outline text="display: &quot;Set title...&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Edit the title of the item.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;edit&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.editTitle ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //edit linkblog link -- 10/28/26 by CC -- #218">
						<outline text="name: &quot;editLinkblogLink&quot;,">
						</outline>
						<outline text="display: &quot;Edit linkblog link...&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Edit the link this post points to.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="globals.myChatUserInterface.editLinkblogLink ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //view data">
						<outline text="name: &quot;viewData&quot;,">
						</outline>
						<outline text="display: &quot;View data...&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;View the data we're storing for the item.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;View data&quot;);">
							</outline>
							<outline text="const editorData = globals.myChatUserInterface.getEditorData ();">
							</outline>
							<outline text="viewItemData (editorData);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="]">
					</outline>
				</outline>
				<outline text="const timelineItemMenu = [ //6/10/26 by DW">
					<outline text="{ //edit">
						<outline text="name: &quot;edit&quot;,">
						</outline>
						<outline text="display: &quot;Edit&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Edit the contents of this post.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;edit&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.editItem (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //delete">
						<outline text="name: &quot;delete&quot;,">
						</outline>
						<outline text="display: &quot;Delete&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Delete this post.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;delete&quot;);">
							</outline>
							<outline text="deletePostCommand (ev.item);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //divider">
						<outline text="flDivider: true">
						</outline>
						<outline text="}, ">
						</outline>
					</outline>
					<outline text="{ //flipswitch" isComment="true">
						<outline text="name: &quot;flipswitch&quot;,">
						</outline>
						<outline text="display: &quot;Flip to the other view&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Switch between timeline and tree views&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;flipswitch&quot;);">
							</outline>
							<outline text="globals.myChatUserInterface.flipScanner (ev.item.id)">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //divider" isComment="true">
						<outline text="flDivider: true">
						</outline>
						<outline text="}, ">
						</outline>
					</outline>
					<outline text="{ //placeholder 1">
						<outline text="name: &quot;placeholder1&quot;,">
						</outline>
						<outline text="display: &quot;Placeholder #1&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Something useful will be here soon.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;Placeholder #1&quot;);">
							</outline>
							<outline text="alertDialog (&quot;This is just a placeholder while the app is in development. There will be commands here but they aren't ready yet.&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //placeholder 2">
						<outline text="name: &quot;placeholder2&quot;,">
						</outline>
						<outline text="display: &quot;Placeholder #2&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Something useful will be here soon.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;Placeholder #2&quot;);">
							</outline>
							<outline text="alertDialog (&quot;This is just a placeholder while the app is in development. There will be commands here but they aren't ready yet.&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //hello" isComment="true">
						<outline text="name: &quot;hello&quot;,">
						</outline>
						<outline text="display: &quot;Hello&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Say hello to the user.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;hello&quot;);">
							</outline>
							<outline text="alertDialog (&quot;Hello.&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="{ //goodbye" isComment="true">
						<outline text="name: &quot;goodbye&quot;,">
						</outline>
						<outline text="display: &quot;Goodbye&quot;,">
						</outline>
						<outline text="enabled: true, ">
						</outline>
						<outline text="tooltip: &quot;Say goodbye to the user.&quot;, ">
						</outline>
						<outline text="click: function (ev) {">
							<outline text="console.log (&quot;goodbye&quot;);">
							</outline>
							<outline text="alertDialog (&quot;Goodbye.&quot;);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="},">
						</outline>
					</outline>
					<outline text="]">
					</outline>
				</outline>
			</outline>
			<outline text="styles.css">
				<outline text="@import url('https://fonts.googleapis.com/css?family=Archivo+Black');">
				</outline>
				<outline text=":root {">
					<outline text="--font-product-name: &quot;Archivo Black&quot;;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="body {">
					<outline text="padding-top: 65px;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text=".divMenuProductName {">
					<outline text="font-family: var(--font-product-name);">
					</outline>
					<outline text="font-size: 32px;">
					</outline>
					<outline text="letter-spacing: -1px;">
					</outline>
					<outline text="margin-top: 4px;">
					</outline>
					<outline text="opacity: 0.7;">
					</outline>
					<outline text="color: black;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text=".divThemeVersion { /* 5/24/26 by DW */">
					<outline text="font-size: 14px;">
					</outline>
					<outline text="float: right;">
					</outline>
					<outline text="padding-top: 15px; ">
					</outline>
					<outline text="padding-right: 12px;">
					</outline>
					<outline text="cursor: pointer;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text=".divTabsFromOutline { /* 5/27/26 by DW -- used in settings dialog */">
					<outline text="font-size: 16px;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text=".divAboutDialogText ul { /* 6/28/26 by DW */">
					<outline text="list-style-type: none;">
					</outline>
					<outline text="margin: 0;">
					</outline>
					<outline text="padding-top: 10px;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text=".divAboutDialogText li {">
					<outline text="margin-top: 5px;">
					</outline>
					<outline text="line-height: 140%;">
					</outline>
					<outline text="}">
					</outline>
				</outline>
			</outline>
			<outline text="settings.opml">
				<outline text="Feed">
					<outline text="&lt;p&gt;You can set the title, link and description for the feed that we maintain for you.&lt;/p&gt;">
					</outline>
					<outline text="&lt;%prefs.stringPref (&quot;TItle&quot;, &quot;myFeedTitle&quot;, &quot;Your feed's title.&quot;)%&gt;">
					</outline>
					<outline text="&lt;%prefs.stringPref (&quot;Link&quot;, &quot;myFeedLink&quot;, &quot;Link to your home page or profile site.&quot;)%&gt;">
					</outline>
					<outline text="&lt;%prefs.textAreaPref (&quot;Description&quot;, &quot;myFeedDescription&quot;, &quot;A short description of your feed.&quot;, rows:3)%&gt;">
					</outline>
					<outline text="&lt;%prefs.stringPref (&quot;Avatar URL&quot;, &quot;myAvatarImageUrl&quot;, &quot;A square image that represents you on the net.&quot;)%&gt;">
					</outline>
				</outline>
				<outline text="Prompts">
					<outline text="&lt;%prefs.stringPref (&quot;New post&quot;, &quot;placeholderSignedIn&quot;, &quot;What's happening?&quot;)%&gt;">
					</outline>
					<outline text="&lt;%prefs.stringPref (&quot;Reply&quot;, &quot;placeholderReply&quot;, &quot;Post your reply&quot;)%&gt;">
					</outline>
				</outline>
			</outline>
			<outline text="api.js">
				<outline text="function rssNetworkServer (userOptions) {">
					<outline text="var rssNetworkMemory = { //saved in localStorage">
						<outline text="email: undefined,">
						</outline>
						<outline text="code: undefined,">
						</outline>
						<outline text="screenname: undefined">
						</outline>
						<outline text="};">
						</outline>
					</outline>
					<outline text="var options = {">
						<outline text="serverAddress: undefined">
						</outline>
						<outline text="};">
						</outline>
					</outline>
					<outline text="mergeOptions (userOptions, options);">
					</outline>
					<outline text="">
					</outline>
					<outline text="var myFeedUrl = undefined, baseFeedUrl = undefined;">
					</outline>
					<outline text="var flWillRedirect = false; //5/17/26 by DW -- will be true if we're redirecting when things settle down">
					</outline>
					<outline text="">
					</outline>
					<outline text="function saveMemory () {">
						<outline text="localStorage.rssNetworkMemory = JSON.stringify (rssNetworkMemory);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function loadMemory () {">
						<outline text="if (localStorage.rssNetworkMemory !== undefined) {">
							<outline text="var jstruct = JSON.parse (localStorage.rssNetworkMemory);">
							</outline>
							<outline text="for (var x in jstruct) {">
								<outline text="rssNetworkMemory [x] = jstruct [x];">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getLinkToAppPage () {">
						<outline text="return (stringNthField (stringNthField (window.location.href, &quot;?&quot;, 1), &quot;#&quot;, 1));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function handleEmailConfirm () {">
						<outline text="var params = new URLSearchParams (location.search);">
						</outline>
						<outline text="if (params.get (&quot;emailconfirmed&quot;) === &quot;true&quot;) {">
							<outline text="rssNetworkMemory.email = params.get (&quot;email&quot;);">
							</outline>
							<outline text="rssNetworkMemory.code = params.get (&quot;code&quot;);">
							</outline>
							<outline text="rssNetworkMemory.screenname = params.get (&quot;screenname&quot;);">
							</outline>
							<outline text="saveMemory ();">
							</outline>
							<outline text="flWillRedirect = true; //5/17/26 by DW">
							</outline>
							<outline text="location.href = getLinkToAppPage ();">
							</outline>
							<outline text="" isComment="true">
							</outline>
							<outline text="localStorage.debugParams = location.search; //5/10/26 by DW" isComment="true">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function buildQueryString (params) {">
						<outline text="var result = &quot;&quot;;">
						</outline>
						<outline text="if (params !== undefined) {">
							<outline text="for (var x in params) {">
								<outline text="if (params [x] !== undefined) {">
									<outline text="if (result.length &gt; 0) {">
										<outline text="result += &quot;&amp;&quot;;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="result += encodeURIComponent (x) + &quot;=&quot; + encodeURIComponent (params [x]);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="return (result);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function servercall (path, params, flAuthenticated, method, callback) {">
						<outline text="Changes" isComment="true">
							<outline text="6/12/26; 12:12:09 PM by DW">
								<outline text="Added flAuthenticated param. If true we add the params for authentication, rather than having to replicate the code in every call.">
								</outline>
								<outline text="If this had been cc'd from FeedLand we would have gotten the params right the first time. ">
								</outline>
							</outline>
						</outline>
						<outline text="method = (method === undefined) ? &quot;GET&quot; : method;">
						</outline>
						<outline text="var url = options.serverAddress + path;">
						</outline>
						<outline text="">
						</outline>
						<outline text="if (params === undefined) { //6/12/26 by DW">
							<outline text="params = new Object ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="if (getBoolean (flAuthenticated)) {">
							<outline text="params.emailaddress = rssNetworkMemory.email;">
							</outline>
							<outline text="params.emailcode = rssNetworkMemory.code;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="var qs = buildQueryString (params);">
						</outline>
						<outline text="if (qs.length &gt; 0) {">
							<outline text="url += &quot;?&quot; + qs;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="fetch (url, {method}) .then (function (response) {">
							<outline text="return (response.text () .then (function (responseText) {">
								<outline text="if (response.ok) {">
									<outline text="try {">
										<outline text="const jstruct = JSON.parse (responseText);">
										</outline>
										<outline text="callback (undefined, jstruct);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="catch (err) {">
										<outline text="callback (err);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="try {">
										<outline text="const jstruct = JSON.parse (responseText);">
										</outline>
										<outline text="callback (jstruct);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="catch (err) {">
										<outline text="callback ({message: responseText});">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {" isComment="true">
									<outline text="callback ({message: responseText});">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}));">
								</outline>
							</outline>
							<outline text="})">
							</outline>
						</outline>
						<outline text=".catch (function (err) {">
							<outline text="callback (err);">
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function createAccount (email, name=undefined, callback) {">
						<outline text="Changes" isComment="true">
							<outline text="6/15/26; 1:13:28 PM by DW">
								<outline text="Added new optional param, name, defaults to everything to the left of @ in email address.">
								</outline>
							</outline>
						</outline>
						<outline text="var params = {">
							<outline text="email,">
							</outline>
							<outline text="name: (name == undefined) ? trimWhitespace (stringNthField (email, &quot;@&quot;, 1)) : name,">
							</outline>
							<outline text="urlredirect: getLinkToAppPage ()">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="servercall (&quot;createnewuser&quot;, params, false, &quot;GET&quot;, callback); //this is in daveappserver -- 6/5/26 by DW">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function signIn (email, callback) {">
						<outline text="var params = {">
							<outline text="email,">
							</outline>
							<outline text="name: trimWhitespace (stringNthField (email, &quot;@&quot;, 1))," isComment="true">
							</outline>
							<outline text="urlredirect: getLinkToAppPage ()">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="servercall (&quot;sendconfirmingemail&quot;, params, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getFeedUrl () {">
						<outline text="return (myFeedUrl);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getBaseFeedUrl () {">
						<outline text="return (baseFeedUrl);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getFeed (screenname, callback) {">
						<outline text="servercall (&quot;feed&quot;, {screenname}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getUserData (screenname, callback) {">
						<outline text="servercall (&quot;getuserdata&quot;, {screenname}, true, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSubscriptionList (callback) {">
						<outline text="servercall (&quot;getsubscriptionlist&quot;, undefined, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function newPost (postRec, callback) {">
						<outline text="Changes" isComment="true">
							<outline text="4/30/26; 11:27:20 AM by DW">
								<outline text="first param changed to postRec.">
								</outline>
							</outline>
						</outline>
						<outline text="if (userIsSignedIn ()) {">
							<outline text="const params = {">
								<outline text="emailaddress: rssNetworkMemory.email," isComment="true">
								</outline>
								<outline text="emailcode: rssNetworkMemory.code," isComment="true">
								</outline>
								<outline text="jsontext: jsonStringify (postRec),">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="servercall (&quot;newpost&quot;, params, true, &quot;POST&quot;, callback);">
							</outline>
							<outline text="console.log (nowstring () + &quot; rssNetworkServer.newPost: postRec == &quot; + jsonStringify (postRec)); //5/14/26 by DW">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't send a new post because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function updatePost (postRec, callback) { //5/21/26 by DW">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="const params = {">
								<outline text="emailaddress: rssNetworkMemory.email," isComment="true">
								</outline>
								<outline text="emailcode: rssNetworkMemory.code," isComment="true">
								</outline>
								<outline text="jsontext: jsonStringify (postRec),">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="servercall (&quot;updatepost&quot;, params, true, &quot;POST&quot;, callback);">
							</outline>
							<outline text="console.log (nowstring () + &quot; rssNetworkServer.updatePost: postRec == &quot; + jsonStringify (postRec));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't send a new post because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function deletePost (id, callback) { //5/21/26 by DW">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="servercall (&quot;deletepost&quot;, {id}, true, &quot;POST&quot;, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't delete the post because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getVersion (callback) {">
						<outline text="servercall (&quot;version&quot;, undefined, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function userIsSignedIn () {">
						<outline text="return ((rssNetworkMemory.email !== undefined) &amp;&amp; (rssNetworkMemory.code !== undefined));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSocketGreeting () { //7/17/26 by CC ">
						<outline text="Changes" isComment="true">
							<outline text="7/17/26; 11:06:26 AM by CC">
								<outline text="the goodnightkiss protocol: the string that identifies this connection to the server, undefined if not signed in">
								</outline>
							</outline>
						</outline>
						<outline text="if (userIsSignedIn ()) {">
							<outline text="return (&quot;user &quot; + rssNetworkMemory.email + &quot; &quot; + rssNetworkMemory.code);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="return (undefined);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getScreenname () {">
						<outline text="return (rssNetworkMemory.screenname);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getEmail () {">
						<outline text="return (rssNetworkMemory.email);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function signOut () {">
						<outline text="delete localStorage.rssNetworkMemory;">
						</outline>
						<outline text="location.reload ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getRecentItems (ct, callback) { //4/29/26 by DW">
						<outline text="const screenname = getScreenname (); //6/24/26 by DW">
						</outline>
						<outline text="servercall (&quot;getrecentitems&quot;, {screenname, ct}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function savePrefs (thePrefs, callback) { //5/16/26 by DW">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="const params = {">
								<outline text="emailaddress: rssNetworkMemory.email," isComment="true">
								</outline>
								<outline text="emailcode: rssNetworkMemory.code," isComment="true">
								</outline>
								<outline text="jsontext: jsonStringify (thePrefs),">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="servercall (&quot;saveprefs&quot;, params, true, &quot;POST&quot;, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't save prefs because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function willRedirect () { //5/17/26 by DW">
						<outline text="return (flWillRedirect);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getItemByGuid (guid, callback) { //6/8/26 by DW">
						<outline text="Changes" isComment="true">
							<outline text="6/29/26; 8:47:40 AM by DW">
								<outline text="We're tracking down an error where this function is called with guid == undefined. Added debugging code to find the location.">
								</outline>
							</outline>
						</outline>
						<outline text="if (guid == undefined) {">
							<outline text="const message = &quot;Can't get the item record because the GUID param is undefined.&quot;;">
							</outline>
							<outline text="console.log (&quot;getItemByGuid: &quot; + message);">
							</outline>
							<outline text="console.trace ();">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const screenname = getScreenname (); //6/24/26 by DW">
							</outline>
							<outline text="servercall (&quot;getitembyguid&quot;, {screenname, guid}, false, &quot;GET&quot;, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function checkWhitelist (emailaddress, callback) { //6/9/26 by DW">
						<outline text="servercall (&quot;checkwhitelist&quot;, {emailaddress}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function isUserInDatabase (screenname, callback) { //6/15/26 by DW">
						<outline text="servercall (&quot;isuserindatabase&quot;, {screenname}, true, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function isEmailInDatabase (email, callback) { //6/15/26 by DW">
						<outline text="servercall (&quot;isemailindatabase&quot;, {email}, true, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function toggleLike (id, callback) { //6/24/26 by DW">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="servercall (&quot;togglelike&quot;, {id}, true, &quot;POST&quot;, callback);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't like something because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getLikersList (id, callback) { //6/25/26 by CC">
						<outline text="servercall (&quot;getlikerslist&quot;, {id}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getRecentUserItems (name, callback) { //6/26/26 by DW">
						<outline text="const screenname = getScreenname ();">
						</outline>
						<outline text="servercall (&quot;getrecentuseritems&quot;, {screenname, name}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getItemAndReplies (screenname, idparent, callback) { //6/30/26 by DW">
						<outline text="servercall (&quot;getitemandreplies&quot;, {screenname, idparent}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getMostActiveToday (callback) { //7/1/26 by DW">
						<outline text="servercall (&quot;getmostactivetoday&quot;, undefined, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function uploadMedia (type, base64text, callback) { //7/22/26 by CC -- #188">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="const params = {">
								<outline text="type,">
								</outline>
								<outline text="emailaddress: rssNetworkMemory.email,">
								</outline>
								<outline text="emailcode: rssNetworkMemory.code">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="const url = options.serverAddress + &quot;uploadmedia?&quot; + buildQueryString (params);">
							</outline>
							<outline text="fetch (url, {method: &quot;POST&quot;, body: base64text}) .then (function (response) {">
								<outline text="return (response.text () .then (function (responseText) {">
									<outline text="if (response.ok) {">
										<outline text="try {">
											<outline text="const jstruct = JSON.parse (responseText);">
											</outline>
											<outline text="callback (undefined, jstruct);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="callback (err);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="try {">
											<outline text="const jstruct = JSON.parse (responseText);">
											</outline>
											<outline text="callback (jstruct);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="callback ({message: responseText});">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}));">
									</outline>
								</outline>
								<outline text="})">
								</outline>
							</outline>
							<outline text=".catch (function (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't upload the image because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function readHttpFile (url, callback) { //7/30/26 by DW">
						<outline text="servercall (&quot;readhttpfile&quot;, {url}, false, &quot;GET&quot;, function (err, jstruct) {">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="callback (undefined, jstruct.filetext);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function start (callback) { //async stuff we do at start -- 4/22/26 by DW">
						<outline text="Changes" isComment="true">
							<outline text="6/13/26; 3:16:06 PM by DW">
								<outline text="The callback takes the standard two params. We pass back any error called by the server, the app is meant to display the message in a dialog and then do nothing. ">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;rssNetworkServer.start&quot;);">
						</outline>
						<outline text="getUserData (rssNetworkMemory.screenname, function (err, userData) {">
							<outline text="if (err) {">
								<outline text="console.log (&quot;start: err.message == &quot; + err.message);">
								</outline>
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;start: userData == &quot; + jsonStringify (userData));">
								</outline>
								<outline text="myFeedUrl = userData.feedUrl;">
								</outline>
								<outline text="baseFeedUrl = userData.baseFeedUrl;">
								</outline>
								<outline text="callback (undefined, userData);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="loadMemory ();">
					</outline>
					<outline text="handleEmailConfirm ();">
					</outline>
					<outline text="">
					</outline>
					<outline text="console.log (&quot;rssNetworkServer: rssNetworkMemory == &quot; + jsonStringify (rssNetworkMemory));">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.createAccount = createAccount; //4/20/26 by DW">
					</outline>
					<outline text="this.signIn = signIn; //4/19/26 by DW">

					</outline>
				</outline>
				<outline text="//handling socket items -- 4/23/26 by DW">
					<outline text="var idsSeen = new Array ();">
					</outline>
					<outline text="">
					</outline>
					<outline text="function ageoutIdsSeen () { //age out items in idsSeen array">
						<outline text="var newArray = new Array ();">
						</outline>
						<outline text="idsSeen.forEach (function (item) {">
							<outline text="if (secondsSince (item.when) &lt; appConsts.maxSecsForIds) {">
								<outline text="newArray.push (item);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;ageoutIdsSeen: ageing out == &quot; + jsonStringify (item));" isComment="true">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="idsSeen = newArray;">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function isFeedInExtras (feedUrl) { //5/18/26 by DW">
						<outline text="">
						</outline>
						<outline text="return (false); //feature disabled -- 5/18/26 by DW">
						</outline>
						<outline text="">
						</outline>
						<outline text="var flFound = false;">
						</outline>
						<outline text="globals.userData.extrasList.forEach (function (xmlUrl) {">
							<outline text="if (xmlUrl === feedUrl) {">
								<outline text="flFound = true;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="return (flFound);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function includeSocketItem (theItem) { ">
						<outline text="Changes" isComment="true">
							<outline text="6/8/26; 10:08:20 AM by DW">
								<outline text="Don't include globals.userData.feedUrlEveryone.">
								</outline>
							</outline>
							<outline text="5/17/26; 4:53:25 PM by DW">
								<outline text="Added support for extras list. ">
								</outline>
							</outline>
							<outline text="4/24/26; 10:56:12 AM by DW">
								<outline text="Only inclide an item from the socket if it's one of ours and we haven't seen it before. ">
								</outline>
							</outline>
						</outline>
						<outline text="//exclude items we've already seen">
							<outline text="var flInclude = true; ">
							</outline>
							<outline text="idsSeen.forEach (function (item) {">
								<outline text="if (item.id === theItem.id) {">
									<outline text="flInclude = false;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="if (flInclude) {">
								<outline text="idsSeen.push ({">
									<outline text="id: theItem.id,">
									</outline>
									<outline text="when: new Date ()">
									</outline>
									<outline text="})">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="return (false); //don't include, already seen">
								</outline>
								<outline text="}">
								</outline>
							</outline>
						</outline>
						<outline text="//include items from our feeds">
							<outline text="const baseFeedUrl = globals.myRssNetwork.getBaseFeedUrl ();" isComment="true">
							</outline>
							<outline text="if (beginsWith (theItem.feedUrl, globals.userData.baseFeedUrl)) {">
								<outline text="if (theItem.feedUrl == globals.userData.feedUrlEveryone) { //6/8/26 by DW">
									<outline text="return (false);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="return (true);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="if (isFeedInExtras (theItem.feedUrl)) {">
									<outline text="return (true);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="return (appConsts.flIncludeAllSocketItems);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function socketItemHandler (flNew, theFeed, theItem) { //6/21/26 by CC">
						<outline text="Changes" isComment="true">
							<outline text="6/21/26 by CC">
								<outline text="socket delivers a render-ready item now; no refetch, no theFeed merge">
								</outline>
							</outline>
						</outline>
						<outline text="if (includeSocketItem (theItem)) {">
							<outline text="console.log (&quot;socketItemHandler: flNew == &quot; + flNew + &quot;, feedUrl == &quot; + theItem.feedUrl);">
							</outline>
							<outline text="if (flNew) {">
								<outline text="globals.myChatUserInterface.newItem (theItem);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="globals.myChatUserInterface.updateItem (theItem);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function socketItemHandler (flNew, theFeed, theItem) { //5/22/26 by DW" isComment="true">
						<outline text="Changes" isComment="true">
							<outline text="5/22/26; 10:07:09 AM by DW">
								<outline text="Factored from socketNewItemCallback. ">
								</outline>
							</outline>
							<outline text="5/18/26; 9:40:26 AM by DW">
								<outline text="Handle &quot;extra&quot; items. ">
								</outline>
								<outline text="Commented out when we hit a deal stopper, ask Claude about it.">
								</outline>
							</outline>
							<outline text="5/15/26; 10:56:11 AM by DW">
								<outline text="Added guid to chatItem, needed to properly insert items in reply to another post. ">
								</outline>
								<outline text="what's in theItem -- 5/15/26 by DW" isComment="true">
									<outline text="{">
										<outline text="&quot;feedUrl&quot;: &quot;https://users.rss.network/dave.winer/rss.xml&quot;,">
										</outline>
										<outline text="&quot;guid&quot;: &quot;https://rss.network/permalink?screenname=dave.winer&amp;id=gbudzxlw&quot;,">
										</outline>
										<outline text="&quot;link&quot;: &quot;https://rss.network/permalink?screenname=dave.winer&amp;id=gbudzxlw&quot;,">
										</outline>
										<outline text="&quot;description&quot;: &quot;we had a problem, a new reply wasn't going into the right place. working with claude we found the problem with zero stress for me.&quot;,">
										</outline>
										<outline text="&quot;id&quot;: 2879846,">
										</outline>
										<outline text="&quot;pubDate&quot;: &quot;Fri, 15 May 2026 14:49:38 GMT&quot;,">
										</outline>
										<outline text="&quot;whenReceived&quot;: &quot;Fri, 15 May 2026 14:49:38 GMT&quot;,">
										</outline>
										<outline text="&quot;whenUpdated&quot;: &quot;Fri, 15 May 2026 14:49:38 GMT&quot;,">
										</outline>
										<outline text="&quot;likes&quot;: [],">
										</outline>
										<outline text="&quot;metadata&quot;: {},">
										</outline>
										<outline text="&quot;ctLikes&quot;: 0,">
										</outline>
										<outline text="&quot;markdowntext&quot;: &quot;we had a problem, a new reply wasn't going into the right place. working with claude we found the problem with zero stress for me.&quot;">
										</outline>
										<outline text="}">
										</outline>
									</outline>
								</outline>
							</outline>
						</outline>
						<outline text="if (includeSocketItem (theItem)) {">
							<outline text="globals.myRssNetwork.getItemByGuid (theItem.guid, function (err, theItem) {">
								<outline text="var screenname = (err) ? undefined : theItem.author;">
								</outline>
								<outline text="console.log (&quot;socketItemHandler: flNew == &quot; + flNew + &quot;, feedUrl == &quot; + theItem.feedUrl);">
								</outline>
								<outline text="const chatItem = {">
									<outline text="screenname, //6/8/26 by DW">
									</outline>
									<outline text="feedUrl: theItem.feedUrl,">
									</outline>
									<outline text="author: theFeed.title,">
									</outline>
									<outline text="title: theItem.title, //5/23/26 by DW">
									</outline>
									<outline text="description: theItem.description, //5/23/26 by DW">
									</outline>
									<outline text="pubDate: theItem.pubDate,">
									</outline>
									<outline text="guid: theItem.guid, //5/15/26 by DW">
									</outline>
									<outline text="imageUrl: theFeed.imageUrl, //6/2/26 by DW">
									</outline>
									<outline text="imageTitle: theFeed.imageTitle,">
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="console.log (nowstring () + &quot; socketItemHandler: chatItem == &quot; + jsonStringify (chatItem));">
								</outline>
								<outline text="if (flNew) {">
									<outline text="globals.myChatUserInterface.newItem (chatItem);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="globals.myChatUserInterface.updateItem (chatItem);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="" isComment="true">
							</outline>
							<outline text="if (isFeedInExtras (theItem.feedUrl)) { //5/18/26 by DW" isComment="true">
								<outline text="globals.myRssNetwork.saveExtraItem (chatItem);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function socketNewItemCallback (theFeed, theItem) { ">
						<outline text="socketItemHandler (true, theFeed, theItem); ">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="if (includeSocketItem (theItem)) {" isComment="true">
							<outline text="console.log (&quot;socketNewItemCallback: feedUrl == &quot; + theItem.feedUrl);">
							</outline>
							<outline text="">
							</outline>
							<outline text="const chatItem = {">
								<outline text="feedUrl: theItem.feedUrl,">
								</outline>
								<outline text="author: theFeed.title,">
								</outline>
								<outline text="description: getItemText (theItem),">
								</outline>
								<outline text="pubDate: theItem.pubDate,">
								</outline>
								<outline text="guid: theItem.guid //5/15/26 by DW">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="console.log (nowstring () + &quot; socketNewItemCallback: chatItem == &quot; + jsonStringify (chatItem));">
							</outline>
							<outline text="globals.myChatUserInterface.newItem (chatItem);">
							</outline>
							<outline text="if (isFeedInExtras (theItem.feedUrl)) { //5/18/26 by DW" isComment="true">
								<outline text="globals.myRssNetwork.saveExtraItem (chatItem);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function socketUpdatedItemCallback (theFeed, theItem) {">
						<outline text="socketItemHandler (false, theFeed, theItem); ">
						</outline>
						<outline text="console.log (&quot;updatedItemCallback&quot;);" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="//themes -- 5/1/26 by DW">
					<outline text="function updateTheme (themeName, callback) {">
						<outline text="Changes" isComment="true">
							<outline text="7/7/26; 11:19:02 AM by DW">
								<outline text="Added a cache confuser.">
								</outline>
							</outline>
							<outline text="5/30/26; 10:34:51 AM by DW">
								<outline text="new callback param. we load the current theme's css and js files from s3.">
								</outline>
							</outline>
						</outline>
						<outline text="const cacheConfuser = &quot;?x=&quot; + new Date ().getTime (), whenstart = new Date ();">
						</outline>
						<outline text="if (themeName === undefined) {">
							<outline text="themeName = appPrefs.currentThemeName;">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="console.log (&quot;switchTheme: themeName == &quot; + themeName);">
						</outline>
						<outline text="const baseUrl = appConsts.urlThemes + themeName + &quot;/&quot;;">
						</outline>
						<outline text="">
						</outline>
						<outline text="function installJavaScriptCode (theCode) {">
							<outline text="$(&quot;#scriptTheme&quot;).remove ();">
							</outline>
							<outline text="const scriptTheme = document.createElement (&quot;script&quot;);">
							</outline>
							<outline text="scriptTheme.id = &quot;scriptTheme&quot;;">
							</outline>
							<outline text="scriptTheme.textContent = theCode;">
							</outline>
							<outline text="document.head.appendChild (scriptTheme);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function installCssStyles (theStyles) {">
							<outline text="$(&quot;#styleTheme&quot;).remove ();">
							</outline>
							<outline text="const styleTheme = document.createElement (&quot;style&quot;);">
							</outline>
							<outline text="styleTheme.id = &quot;styleTheme&quot;;">
							</outline>
							<outline text="styleTheme.textContent = theStyles;">
							</outline>
							<outline text="document.head.appendChild (styleTheme);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="const urlStyles = baseUrl + &quot;theme.css&quot; + cacheConfuser;">
						</outline>
						<outline text="httpRequest (urlStyles, undefined, undefined, function (err, cssText) {">
							<outline text="if (err) {">
								<outline text="console.log (&quot;updateTheme: urlStyles == &quot; + urlStyles + &quot;, err.message == &quot; + err.message);">
								</outline>
								<outline text="const message = &quot;Can't boot up, because we failed to load theme styles from the server.&quot;;">
								</outline>
								<outline text="callback ({message});">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="const urlCode = baseUrl + &quot;theme.js&quot; + cacheConfuser;">
								</outline>
								<outline text="httpRequest (urlCode, undefined, undefined, function (err, jsText) {">
									<outline text="if (err) {">
										<outline text="console.log (&quot;updateTheme: urlCode == &quot; + urlCode + &quot;, err.message == &quot; + err.message);">
										</outline>
										<outline text="const message = &quot;Can't boot up, because we failed to load theme code from the server.&quot;;">
										</outline>
										<outline text="callback ({message});">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="installJavaScriptCode (jsText)">
										</outline>
										<outline text="installCssStyles (cssText);">
										</outline>
										<outline text="console.log (&quot;updateTheme: &quot; + secondsSince (whenstart) + &quot; secs.&quot;);">
										</outline>
										<outline text="callback (undefined);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="const theTheme = themes [themeName];" isComment="true">
						</outline>
						<outline text="installJavaScriptCode (theTheme.code)" isComment="true">
						</outline>
						<outline text="installCssStyles (theTheme.styles);" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function itemSelectedCallback (theItem) { //6/1/26 by DW -- called when user clicks on a timeline item">
						<outline text="console.log (&quot;itemSelectedCallback: theItem == &quot; + jsonStringify (theItem));" isComment="true">
						</outline>
						<outline text="globals.currentTimelineItem = theItem;">
						</outline>
						<outline text="enableMenuItems (); //6/10/26 by DW">
						</outline>
						<outline text="enableIcons (); //6/12/26 by DW">
						</outline>
						<outline text="setLastMessageRead (theItem); //6/27/26 by DW">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function enableIcons () { //6/1/26 by DW">
						<outline text="function enableItemIcons () {">
							<outline text="insideItemIcons.forEach (function (item) {">
								<outline text="switch (item.name) {">
									<outline text="case &quot;comment&quot;:">
										<outline text="item.enabled = true;">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;pencil&quot;:">
										<outline text="item.enabled = userCanEditTimelineItem (); //6/9/26 by DW">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;eye&quot;:">
										<outline text="item.enabled = enableEyeIcon (); //6/9/26 by DW">
										</outline>
										<outline text="item.enabled = (random (0, 1) == 0) ? false : true;" isComment="true">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;trashcan&quot;:">
										<outline text="item.enabled = userCanEditTimelineItem ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function enableGlobalIcons () {">
							<outline text="leftColumnIcons.forEach (function (item) {">
								<outline text="switch (item.name) {">
									<outline text="case &quot;home&quot;:">
										<outline text="item.enabled = globals.myChatUserInterface.canHome ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;bigPlus&quot;:">
										<outline text="item.enabled = isLoggedIn ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;feed&quot;:">
										<outline text="item.enabled = isLoggedIn ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;data&quot;:">
										<outline text="item.enabled = isLoggedIn ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;flipswitch&quot;: //7/4/26 by DW">
										<outline text="item.enabled = globals.myChatUserInterface.canFlip ();">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="case &quot;surface&quot;: //7/10/26 by DW">
										<outline text="item.enabled = globals.myChatUserInterface.canSurface ();">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="case &quot;hoist&quot;:" isComment="true">
										<outline text="item.enabled = globals.myChatUserInterface.canHoist ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="case &quot;dehoist&quot;:" isComment="true">
										<outline text="item.enabled = globals.myChatUserInterface.isHoisted ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="enableItemIcons ();">
						</outline>
						<outline text="enableGlobalIcons ();">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function enableMenuItems () { //6/10/26 by DW">
						<outline text="timelineItemMenu.forEach (function (item) {">
							<outline text="switch (item.name) {">
								<outline text="case &quot;edit&quot;:">
									<outline text="item.enabled = userCanEditTimelineItem (); ">
									</outline>
									<outline text="break">
									</outline>
								</outline>
								<outline text="case &quot;delete&quot;: //7/5/26 by CC">
									<outline text="item.enabled = userCanEditTimelineItem (); ">
									</outline>
									<outline text="break">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function avatarClickedCallback (screenname, ev) { //6/15/26 by DW">
						<outline text="const url = location.origin + &quot;?screenname=&quot; + screenname;">
						</outline>
						<outline text="history.pushState ({name: screenname}, &quot;&quot;, url);">
						</outline>
						<outline text="globals.myChatUserInterface.viewProfile (screenname);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function avatarClickedCallback (screenname, ev) { //6/15/26 by DW" isComment="true">
						<outline text="console.log (&quot;avatarClickedCallback: screenname == &quot; + screenname);">
						</outline>
						<outline text="globals.myRssNetwork.getUserData (screenname, function (err, theData) {">
							<outline text="if (err) {">
								<outline text="console.log (&quot;avatarClickedCallback: err.message == &quot; + err.message);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;avatarClickedCallback: theData == &quot; + jsonStringify (theData));">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="">
					</outline>
				</outline>
				<outline text="//socket --7/17/26 by DW">
					<outline text="function firehoseSocket (userOptions) {">
						<outline text="Changes" isComment="true">
							<outline text="7/19/26; 9:30:31 AM by DW">
								<outline text="Changed name from feedlandSocket. We're not calling FeedLand so this is confusing. We are consistently referring to it as &quot;firehose.&quot;">
								</outline>
							</outline>
							<outline text="7/17/26; 11:01:36 AM by DW">
								<outline text="claude completely rewrote the routine, and i haven't read the code. i think it's time to trust it with this kind of stuff. famous last words. :-)">
								</outline>
							</outline>
							<outline text="7/17/26; 10:51:03 AM by CC">
								<outline text="implement the goodnight kiss. When the socket opens and the user is signed in, we send &quot;user email code&quot; to identify the connection. The server (daveappserver's kissOtherLogonsGoodnight) then sends &quot;goodnight&quot; to every other connection signed on as the same user. When we receive goodnight, we close the socket, stop reconnecting, and put up a dialog; OK reloads the page. This means only one copy of the app is live per user, so a stale copy can never save old prefs over changes made in a newer one.">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;firehoseSocket&quot;);">
						</outline>
						<outline text="">
						</outline>
						<outline text="const options = {">
							<outline text="flWebsocketEnabled: true,">
							</outline>
							<outline text="urlFirehoseSocket: undefined,">
							</outline>
							<outline text="">
							</outline>
							<outline text="maxRetries: 100, //when we lose a connection, we try to reconnect this many times">
							</outline>
							<outline text="ctSecsBetwRetries: 10,">
							</outline>
							<outline text="initialCheckTimeout: 100,">
							</outline>
							<outline text="">
							</outline>
							<outline text="flLogNewItem: false,">
							</outline>
							<outline text="flLogUpdatedItem: false,">
							</outline>
							<outline text="">
							</outline>
							<outline text="newItemCallback: function (theFeed, theItem) {">
								<outline text="},">
								</outline>
							</outline>
							<outline text="updatedItemCallback: function (theFeed, theItem) {">
								<outline text="},">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="getSocketGreeting: function () { //7/16/26 by CC -- returns &quot;user email code&quot; when signed in, undefined when not">
								<outline text="return (undefined);">
								</outline>
								<outline text="},">
								</outline>
							</outline>
							<outline text="goodnightDialogMsg: &quot;The app is running in another tab or browser. Click OK to reload this one, or you can safely close it.&quot;, //7/16/26 by CC">
							</outline>
							<outline text="">
							</outline>
							<outline text="maxSecsBetwNotifications: 10.1, //7/4/26 by DW -- a notice on the same id less than x secs apart are considered to be the same one">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="mergeOptions (userOptions, options);">
						</outline>
						<outline text="">
						</outline>
						<outline text="var ctNewItems = 0, ctUpdatedItems = 0;">
						</outline>
						<outline text="var recentIds = new Object ();">
						</outline>
						<outline text="function notSeenRecently (id) {">
							<outline text="var flSeen = false;">
							</outline>
							<outline text="function ageOut () {">
								<outline text="var newObject = new Object ();">
								</outline>
								<outline text="for (var x in recentIds) {">
									<outline text="if (secondsSince (recentIds [x]) &lt;= options.maxSecsBetwNotifications) {">
										<outline text="newObject [x] = recentIds [x];">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="recentIds = newObject;">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="ageOut (); //remove expired ids">
							</outline>
							<outline text="for (var x in recentIds) {">
								<outline text="if (id == x) {">
									<outline text="flSeen = true;">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="recentIds [id] = new Date ();">
							</outline>
							<outline text="return (!flSeen);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function handleMessage (theCommand, thePayload) {">
							<outline text="function getTitle (item) {">
								<outline text="if (item.title === undefined) {">
									<outline text="return (maxStringLength (stripMarkup (item.description), 35));">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="return (item.title);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="if (thePayload.item !== undefined) { //debugging">
								<outline text="switch (theCommand) {">
									<outline text="case &quot;newItem&quot;:">
										<outline text="ctNewItems++;">
										</outline>
										<outline text="var wpData = &quot;&quot;;">
										</outline>
										<outline text="if (thePayload.item.metadata !== undefined) {">
											<outline text="if (thePayload.item.metadata.wpSiteId !== undefined) {">
												<outline text="wpData = thePayload.item.metadata.wpSiteId + &quot;/&quot; + thePayload.item.metadata.wpPostId;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="if (options.flLogNewItem) {">
											<outline text="console.log (`${nowstring ()} ${theCommand} ${thePayload.item.feedUrl} ${wpData}`);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="options.newItemCallback (thePayload.theFeed, thePayload.item)">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="case &quot;updatedItem&quot;: //11/16/25 by DW">
										<outline text="ctUpdatedItems++;">
										</outline>
										<outline text="if (options.flLogUpdatedItem) {">
											<outline text="console.log (`${nowstring ()} ${theCommand} ${thePayload.item.feedUrl}`);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="options.updatedItemCallback (thePayload.theFeed, thePayload.item);">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="var mySocket = undefined, idSocketChecker;">
						</outline>
						<outline text="var ctRetries = 0;">
						</outline>
						<outline text="var flGoodnightDialogShowing = false;">
						</outline>
						<outline text="">
						</outline>
						<outline text="function handleGoodnightMessage () { //7/16/26 by CC">
							<outline text="Changes" isComment="true">
								<outline text="7/19/26; 9:40:45 AM by DW">
									<outline text="now reloads the page no matter how it's dismissed. ">
									</outline>
								</outline>
							</outline>
							<outline text="if (!flGoodnightDialogShowing) {">
								<outline text="flGoodnightDialogShowing = true;">
								</outline>
								<outline text="mySocket.close (1000, &quot;Received goodnight message.&quot;); //1000 is the code for normal closure">
								</outline>
								<outline text="const theDialog = alertDialog (options.goodnightDialogMsg, function () {">
									<outline text="location.reload (true);">
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="theDialog.on (&quot;hidden&quot;, function () { //7/19/26 by CC">
									<outline text="//reload however the dialog is dismissed, incl clicking outside it">
									</outline>
									<outline text="location.reload (true);">
									</outline>
									<outline text="});">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="function checkConnection () {">
							<outline text="if ((mySocket === undefined) &amp;&amp; (!flGoodnightDialogShowing)) { //don't reopen the socket after being told to go away">
								<outline text="mySocket = new WebSocket (options.urlFirehoseSocket);">
								</outline>
								<outline text="mySocket.onopen = function (evt) {">
									<outline text="ctRetries = 0; //we got through">
									</outline>
									<outline text="const greeting = options.getSocketGreeting ();">
									</outline>
									<outline text="if (greeting !== undefined) {">
										<outline text="mySocket.send (greeting);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="mySocket.onmessage = function (evt) {">
									<outline text="function getPayload (jsontext) {">
										<outline text="var thePayload = undefined;">
										</outline>
										<outline text="try {">
											<outline text="thePayload = JSON.parse (jsontext);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="}">
											</outline>
										</outline>
										<outline text="return (thePayload);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="if (evt.data !== undefined) { //no error">
										<outline text="if (evt.data == &quot;goodnight&quot;) { //7/16/26 by CC -- no payload on this one, handle it before the parsing below">
											<outline text="handleGoodnightMessage ();">
											</outline>
											<outline text="return;">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="var theCommand = stringNthField (evt.data, &quot;\r&quot;, 1);">
										</outline>
										<outline text="var jsontext = stringDelete (evt.data, 1, theCommand.length + 1);">
										</outline>
										<outline text="var thePayload = getPayload (jsontext);">
										</outline>
										<outline text="handleMessage (theCommand, thePayload);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="mySocket.onclose = function (evt) {">
									<outline text="mySocket = undefined;">
									</outline>
									<outline text="if (ctRetries++ &gt;= options.maxRetries) {">
										<outline text="clearInterval (idSocketChecker);">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="mySocket.onerror = function (evt) {">
									<outline text="console.log (&quot;firehoseSocket: socket received an error.&quot;);">
									</outline>
									<outline text="};">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="if (options.flWebsocketEnabled) {">
							<outline text="setTimeout (function () {">
								<outline text="checkConnection ();">
								</outline>
								<outline text="idSocketChecker = setInterval (checkConnection, 1000 * options.ctSecsBetwRetries);">
								</outline>
								<outline text="}, options.initialCheckTimeout);">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="//startup support -- 7/13/26 by DW">
					<outline text="function simpleInits () { //7/13/26 by DW -- startup things that don't need to be waited for">
						<outline text="startTurndown (); //7/22/26 by DW">
						</outline>
						<outline text="$(&quot;.divMenuProductName&quot;).text (settingsFromServer.productNameForDisplay); //7/13/26 by DW">
						</outline>
						<outline text="if (endsWith (getDomainFromUrl (settingsFromServer.urlServer), &quot;rss.chat&quot;)) { //7/25/26 by DW">
							<outline text="hitCounter (); ">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function everySecond () {">
						<outline text="if (flPrefsChanged) { //5/16/26 by DW">
							<outline text="flPrefsChanged = false;">
							</outline>
							<outline text="savePrefs ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="enableIcons (); //6/1/26 by DW">
						</outline>
						<outline text="enableMenuItems (); //6/10/26 by DW">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function everyMinute () {">
						<outline text="ageoutIdsSeen () ;">
						</outline>
						<outline text="$(&quot;.spUpdateableTime&quot;).trigger (&quot;update&quot;); //5/6/26 by DW">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="appPrefs.ctMinutes++; //5/16/26 by DW -- testing" isComment="true">
						</outline>
						<outline text="prefsChanged ();" isComment="true">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function startPackages (callback) {">
						<outline text="Changes" isComment="true">
							<outline text="6/13/26; 3:17:12 PM by DW">
								<outline text="We used to only start if the user was signed in. But it's a requirement that the site be readable without the user logging in.">
								</outline>
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="function completeStartPackages () { //5/22/26 by DW">
							<outline text="Changes " isComment="true">
								<outline text="5/22/26; 10:32:39 AM by DW">
									<outline text="We need to wait until the network is initialized before we initialize the chat package because it depends in data downloaded from the network.">
									</outline>
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="var storyGuid = undefined; //6/19/26 by DW">
							</outline>
							<outline text="var params = getAllUrlParams ();">
							</outline>
							<outline text="console.log (&quot;startPackages: params == &quot; + jsonStringify (params));">
							</outline>
							<outline text="if (params.id !== undefined) {">
								<outline text="storyGuid = getPermalinkUrl (params.id);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="function focusChangedCallback (itemId) { //6/27/26 by CC" isComment="true">
								<outline text="Changes" isComment="true">
									<outline text="6/27/26; 1:49:37 PM by DW">
										<outline text="A dive in the flip view; push history so Back surfaces a level">
										</outline>
									</outline>
								</outline>
								<outline text="const url = location.origin + &quot;?focus=&quot; + itemId;">
								</outline>
								<outline text="history.pushState ({focus: itemId}, &quot;&quot;, url);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="const chatOptions = {">
								<outline text="whereToAppend: $(&quot;.divChatContainer&quot;),">
								</outline>
								<outline text="iconBar: leftColumnIcons, //5/20/26 by DW">
								</outline>
								<outline text="itemIconBar: insideItemIcons, //5/22/26 by DW">
								</outline>
								<outline text="placeholderSignedIn: appPrefs.placeholderSignedIn, //5/24/26 by DW">
								</outline>
								<outline text="placeholderSignedOut: appPrefs.placeholderSignedOut,">
								</outline>
								<outline text="placeholderReply: appPrefs.placeholderReply,">
								</outline>
								<outline text="itemSelectedCallback, //6/1/26 by DW">
								</outline>
								<outline text="titleTooltip: &quot;Click to add an optional title.&quot;, //6/7/26 by DW">
								</outline>
								<outline text="timelineItemMenu, //6/10/26 by DW">
								</outline>
								<outline text="editorMenu, //6/10/26 by DW">
								</outline>
								<outline text="avatarClickedCallback, //6/15/26 by DW">
								</outline>
								<outline text="storyGuid, //6/19/26 by DW">
								</outline>
								<outline text="profileName: params.screenname, //6/26/26 by DW">
								</outline>
								<outline text="flScanner: getBoolean (params.scanner), //6/27/26 by DW" isComment="true">
								</outline>
								<outline text="idLastMessageRead: appPrefs.idLastMessageRead, //6/27/26 by DW">
								</outline>
								<outline text="focusChangedCallback, //6/27/26 by DW" isComment="true">
								</outline>
								<outline text="itemSeenCallback: setLastMessageRead, //7/2/26 by DW -- #129: a post that's been on screen is read">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="globals.myChatUserInterface = new chatUserInterface (chatOptions);">
							</outline>
							<outline text="globals.myChatUserInterface.applyPrefs (); //5/19/26 by DW">
							</outline>
							<outline text="if (getBoolean (params.linkblog)) { //10/28/26 by CC -- #218: a linkblogging tool sent us a page to post about">
								<outline text="if (globals.myRssNetwork.userIsSignedIn ()) { //signed out, the link is ignored, wordland's way">
									<outline text="globals.myChatUserInterface.editNewLinkblogItem (params);">
									</outline>
									<outline text="history.replaceState ({}, &quot;&quot;, location.origin); //so a reload doesn't start the post over">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="const socketOptions = {">
								<outline text="urlFirehoseSocket:  appConsts.urlSocketServer, //6/24/26 by DW">
								</outline>
								<outline text="urlFeedlandSocket:  &quot;wss://rss.network/&quot;, //6/21/26 by DW" isComment="true">
								</outline>
								<outline text="urlFeedlandSocket:  &quot;wss://feedland.social/&quot;," isComment="true">
								</outline>
								<outline text="flWebsocketEnabled: appConsts.flSocketsEnabled, //7/20/26 by CC -- #186">
								</outline>
								<outline text="newItemCallback: socketNewItemCallback, //4/20/26 by DW">
								</outline>
								<outline text="updatedItemCallback: socketUpdatedItemCallback,">
								</outline>
								<outline text="getSocketGreeting: function () { //7/17/26 by CC">
									<outline text="return (globals.myRssNetwork.getSocketGreeting ());">
									</outline>
									<outline text="},">
									</outline>
								</outline>
								<outline text="goodnightDialogMsg: getGoodbyDialogMessage (), //7/17/26 by CC">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="globals.myFirehoseSocket = new firehoseSocket (socketOptions); ">
							</outline>
							<outline text="">
							</outline>
							<outline text="window.addEventListener (&quot;popstate&quot;, function (ev) {">
								<outline text="const params = getAllUrlParams ();">
								</outline>
								<outline text="switch (true) {">
									<outline text="case (params.screenname !== undefined): ">
										<outline text="globals.myChatUserInterface.viewProfile (params.screenname);">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="case (params.id !== undefined): ">
										<outline text="globals.myChatUserInterface.viewStory (getPermalinkUrl (params.id));">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="case (params.focus !== undefined):" isComment="true">
										<outline text="globals.myChatUserInterface.showFocus (Number (params.focus));">
										</outline>
										<outline text="break;">
										</outline>
									</outline>
									<outline text="default: ">
										<outline text="globals.myChatUserInterface.viewTimeline ();">
										</outline>
										<outline text="break">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="if (params.screenname !== undefined) {" isComment="true">
									<outline text="globals.myChatUserInterface.viewProfile (params.screenname);">
										<outline text="}">
										</outline>
									</outline>
								</outline>
								<outline text="else {" isComment="true">
									<outline text="if (params.id !== undefined) {">
										<outline text="globals.myChatUserInterface.viewStory (getPermalinkUrl (params.id));">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="globals.myChatUserInterface.viewTimeline ();">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="">
							</outline>
							<outline text="callback ();">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="const rssNetOptions = {">
							<outline text="serverAddress: appConsts.urlServer,">
							</outline>
							<outline text="};">
							</outline>
						</outline>
						<outline text="globals.myRssNetwork = new rssNetworkServer (rssNetOptions);">
						</outline>
						<outline text="">
						</outline>
						<outline text="if (!globals.myRssNetwork.willRedirect ()) {">
							<outline text="globals.myRssNetwork.start (function (err, userData) { ">
								<outline text="if (err) { //6/13/26 by DW">
									<outline text="alertDialog (err.message);">
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="else {">
									<outline text="if (userData.prefs !== undefined) { //5/16/26 by DW">
										<outline text="if (userData.prefs.userCss !== undefined) { //5/28/26 by DW -- gives the user an easy way to start over">
											<outline text="if (trimWhitespace (userData.prefs.userCss).length == 0) {">
												<outline text="userData.prefs.userCss = appPrefs.userCss;">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="for (var x in userData.prefs) {">
											<outline text="appPrefs [x] = userData.prefs [x];">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="globals.userData = userData;">
									</outline>
									<outline text="appPrefs.ctStarts++;">
									</outline>
									<outline text="appPrefs.whenLastStart = new Date ();">
									</outline>
									<outline text="if (appPrefs.lastEmail === undefined) { //5/27/26 by DW">
										<outline text="appPrefs.lastEmail = getEmailAddress ();">
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="fixPrefs (); //7/2/26 by DW">
									</outline>
									<outline text="prefsChanged ();">
									</outline>
									<outline text="updateTheme (undefined, function (err) { //5/30/26 by DW">
										<outline text="if (err) {">
											<outline text="alertDialog (err.message);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="else {">
											<outline text="if (appPrefs.flApplyUserCss) { //5/28/26 by DW">
												<outline text="applyUserCss (appPrefs.userCss);">
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="completeStartPackages (); //5/22/26 by DW">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="});">
										</outline>
									</outline>
									<outline text="}">
									</outline>
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
				</outline>
				<outline text="function startup () {">
					<outline text="console.log (&quot;startup -- 6/5/26 by DW&quot;);">
					</outline>
					<outline text="simpleInits (); //7/13/26 by DW">
					</outline>
					<outline text="startPackages (function () {">
						<outline text="$(&quot;#idUsername&quot;).text (getScreenname ()); //5/16/26 by DW" isComment="true">
						</outline>
						<outline text="$(&quot;#idUsername&quot;).text (appPrefs.lastEmail); " isComment="true">
						</outline>
						<outline text="">
						</outline>
						<outline text="const divThemeVersion = $(&quot;.divThemeVersion&quot;); //7/19/26 by DW -- commented, too many version numbers, use dialog instead" isComment="true">
						</outline>
						<outline text="divThemeVersion.text (firstCharUpper (appPrefs.currentThemeName) + &quot; v&quot; + getThemeVersion ()); //5/24/26 by DW" isComment="true">
						</outline>
						<outline text="divThemeVersion.click (function (ev) { //7/7/26 by DW" isComment="true">
							<outline text="versionsDialog ();">
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="updateForLogin ();">
						</outline>
						<outline text="">
						</outline>
						<outline text="startTurndown ();  //5/19/26 by DW">
						</outline>
						<outline text="">
						</outline>
						<outline text="startScriptsMenus (); //7/30/26; PM by CC">
						</outline>
						<outline text="">
						</outline>
						<outline text="runEveryMinute (everyMinute);">
						</outline>
						<outline text="self.setInterval (everySecond, 1000);">
						</outline>
						<outline text="">
						</outline>
						<outline text="hitCounter (); " isComment="true">
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="hitCounter (); //6/25/26; 12:10:31 PM by DW -- moved to top level" isComment="true">
					</outline>
					<outline text="}">
					</outline>
				</outline>
			</outline>
			<outline text="index.html">
				<outline text="&lt;html&gt;">
					<outline text="&lt;head&gt;">
						<outline text="&lt;title&gt;[%productNameForDisplay%]&lt;/title&gt;">
						</outline>
						<outline text="&lt;title&gt;rss.chat&lt;/title&gt;" isComment="true">
						</outline>
						<outline text="&lt;title&gt;textcast.net&lt;/title&gt;" isComment="true">
						</outline>
						<outline text="&lt;title&gt;textcast.social&lt;/title&gt;" isComment="true">
						</outline>
						<outline text="&lt;title&gt;rss.network&lt;/title&gt;" isComment="true">
						</outline>
						<outline text="&lt;meta charset=&quot;UTF-8&quot;&gt;">
						</outline>
						<outline text="&lt;meta http-equiv=&quot;Content-Type&quot; content=&quot;text/html; charset=utf-8&quot;&gt;">
						</outline>
						<outline text="&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;">
						</outline>
						<outline text="&lt;link rel=&quot;alternate&quot; type=&quot;application/rss+xml&quot; href=&quot;[%feedUrlEveryone%]&quot;&gt;">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;script&gt;">
							<outline text="const settingsFromServer = { //4/15/26 by DW -- values filled in by server">
								<outline text="productName: &quot;[%productName%]&quot;,">
								</outline>
								<outline text="productNameForDisplay: &quot;[%productNameForDisplay%]&quot;,">
								</outline>
								<outline text="appServerVersion: &quot;[%version%]&quot;,">
								</outline>
								<outline text="flEnableLogin: &quot;[%flEnableLogin%]&quot;,">
								</outline>
								<outline text="urlServer: &quot;[%urlServerForClient%]&quot;,">
								</outline>
								<outline text="urlSocketServer: &quot;[%urlWebsocketServerForClient%]&quot;,">
								</outline>
								<outline text="flSocketsEnabled: &quot;[%flWebsocketEnabled%]&quot;,">
								</outline>
								<outline text="feedUrlEveryone: &quot;[%feedUrlEveryone%]&quot;,">
								</outline>
								<outline text="urlMenuOpml: &quot;[%urlMenuOpml%]&quot;,">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="&lt;/script&gt;">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;link rel=&quot;preload&quot; as=&quot;font&quot; type=&quot;font/woff2&quot; href=&quot;//s3.amazonaws.com/scripting.com/code/fontawesome/webfonts/fa-solid-900.woff2&quot; crossorigin&gt; ">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;%basicIncludes2%&gt;">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/dev/api.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;link rel=&quot;stylesheet&quot; href=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/dev/signupdialog.css?x=2&quot;/&gt;">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/dev/signupdialog.js?x=2&quot; /&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;link rel=&quot;stylesheet&quot; href=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/dev/signupdialog.css?x=2&quot;/&gt;" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/dev/signupdialog.js?x=2&quot; /&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/concord/testing/3.0.6/concord.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;link rel=&quot;stylesheet&quot; href=&quot;//s3.amazonaws.com/scripting.com/code/concord/testing/3.0.6/concordstyles.css?x=2&quot;/&gt;">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/fargo.io/code/shared/outliner.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/outlinedialog/code.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;link rel=&quot;stylesheet&quot; href=&quot;//s3.amazonaws.com/scripting.com/code/outlinedialog/styles.css?x=2&quot;&gt; ">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/feedland/home/sockets.js?x=2&quot;&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/rsschat/feedlandsocket.js?x=2&quot;&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/fargo.io/code/markdownConverter.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;script src=&quot;https://cdn.jsdelivr.net/npm/turndown@7.1.1/dist/turndown.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;link href=&quot;https://code.scripting.com/rsschat/chat.css?x=2&quot; rel=&quot;stylesheet&quot;&gt;" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/chat.js?x=2&quot;&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/signupdialog.js?x=2&quot; /&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="&lt;link rel=&quot;stylesheet&quot; href=&quot;https://code.scripting.com/rsschat/signupdialog.css?x=2&quot;/&gt;" isComment="true">
						</outline>
						<outline text="" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/globals.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;script src=&quot;//s3.amazonaws.com/scripting.com/code/rsschat/misc.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/themes.js?x=2&quot;&gt;&lt;/script&gt;" isComment="true">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/api.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="&lt;link href=&quot;https://code.scripting.com/rsschat/styles.css?x=2&quot; rel=&quot;stylesheet&quot;&gt;">
						</outline>
						<outline text="&lt;script src=&quot;https://code.scripting.com/rsschat/code.js?x=2&quot;&gt;&lt;/script&gt;">
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;!-- Facebook metadata --&gt;">
							<outline text="&lt;meta property=&quot;og:url&quot; content=&quot;[%urlServerForClient%]&quot; /&gt;">
							</outline>
							<outline text="&lt;meta property=&quot;og:type&quot; content=&quot;website&quot; /&gt;">
							</outline>
							<outline text="&lt;meta property=&quot;og:title&quot; content=&quot;[%productNameForDisplay%]&quot; /&gt;">
							</outline>
							<outline text="&lt;meta property=&quot;og:description&quot; content=&quot;We're bootstrapping a network of twitter-like systems built out of components of the web and nothing more. Every part replaceable.&quot; /&gt;">
							</outline>
							<outline text="&lt;meta property=&quot;og:image&quot; content=&quot;https://imgs.scripting.com/2026/07/16/rssChatPostScreenShot.png&quot; /&gt;" isComment="true">
							</outline>
							<outline text="&lt;meta property=&quot;og:image&quot; content=&quot;https://imgs.scripting.com/2026/07/16/rssChatForOG.png&quot; /&gt;" isComment="true">
							</outline>
							<outline text="&lt;meta property=&quot;og:site_name&quot; content=&quot;[%productNameForDisplay%]&quot; /&gt;">
							</outline>
						</outline>
						<outline text="&lt;!-- Twitter metadata --&gt;">
							<outline text="&lt;meta name=&quot;twitter:card&quot; content=&quot;summary_large_image&quot;&gt;">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:site&quot; content=&quot;@davewiner&quot;&gt;">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:title&quot; content=&quot;[%productNameForDisplay%]&quot;&gt;">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:url&quot; content=&quot;[%urlServerForClient%]&quot;&gt;">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:description&quot; content=&quot;We're bootstrapping a network of twitter-like systems built out of components of the web and nothing more. Every part replaceable.&quot;&gt;">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:image:src&quot; content=&quot;https://imgs.scripting.com/2026/07/16/rssChatPostScreenShot.png&quot;&gt;" isComment="true">
							</outline>
							<outline text="&lt;meta name=&quot;twitter:image:src&quot; content=&quot;https://imgs.scripting.com/2026/07/16/rssChatForOG.png&quot;&gt;" isComment="true">
							</outline>
						</outline>
						<outline text="">
						</outline>
						<outline text="&lt;/head&gt;">
						</outline>
					</outline>
					<outline text="&lt;body&gt;">
						<outline text="&lt;div class=&quot;divPrefsDialog&quot;&gt;">
							<outline text="&lt;div id=&quot;idPrefsDialog&quot; class=&quot;modal hide fade&quot; tabindex=&quot;-1&quot; role=&quot;dialog&quot; aria-labelledby=&quot;windowTitleLabel&quot; aria-hidden=&quot;true&quot;&gt;">
								<outline text="&lt;div class=&quot;modal-body&quot;&gt;">
									<outline text="&lt;div class=&quot;divDialogElements&quot;&gt;">
										<outline text="&lt;%prefs.includeOutline (&quot;http://scripting.com/code/rsschat/settings.opml&quot;)%&gt;">
										</outline>
										<outline text="&lt;/div&gt;">
										</outline>
									</outline>
									<outline text="&lt;/div&gt;">
									</outline>
								</outline>
								<outline text="&lt;div class=&quot;modal-footer&quot;&gt;">
									<outline text="&lt;a href=&quot;#&quot; class=&quot;btn&quot; onclick=&quot;prefsCloseDialog ();&quot;&gt;Cancel&lt;/a&gt;">
									</outline>
									<outline text="&lt;a href=&quot;#&quot; class=&quot;btn btn-primary&quot; onclick=&quot;prefsOkClicked ();&quot;&gt;OK&lt;/a&gt;">
									</outline>
									<outline text="&lt;/div&gt;">
									</outline>
								</outline>
								<outline text="&lt;/div&gt;">
								</outline>
							</outline>
							<outline text="&lt;/div&gt;">
							</outline>
						</outline>
						<outline text="&lt;div class=&quot;divMenubar&quot;&gt;">
							<outline text="&lt;div class=&quot;topbar-wrapper&quot; style=&quot;z-index: 5;&quot;&gt;">
								<outline text="&lt;div class=&quot;navbar navbar-fixed-top&quot; data-dropdown=&quot;dropdown&quot;&gt;">
									<outline text="&lt;div class=&quot;divThemeVersion&quot;&gt;&lt;/div&gt;">
									</outline>
									<outline text="&lt;div class=&quot;navbar-inner&quot;&gt;">
										<outline text="&lt;div class=&quot;container&quot;&gt;">
											<outline text="&lt;a class=&quot;brand&quot; href=&quot;/&quot; title=&quot;A simple chat network based on RSS 2.0 feeds and websockets.&quot;&gt;">
												<outline text="&lt;span class=&quot;divMenuProductName&quot;&gt;rss.chat&lt;/span&gt;">
												</outline>
												<outline text="&lt;span class=&quot;divMenuProductName&quot;&gt;RSS Chat&lt;/span&gt;" isComment="true">
												</outline>
												<outline text="&lt;span class=&quot;divMenuProductName&quot;&gt;Text&lt;i&gt;Cast&lt;/i&gt;&lt;/span&gt;" isComment="true">
												</outline>
												<outline text="&lt;span class=&quot;divMenuProductName&quot;&gt;&lt;i&gt;Really&lt;/i&gt; Simple&lt;/span&gt;" isComment="true">
												</outline>
												<outline text="&lt;/a&gt;">
												</outline>
											</outline>
											<outline text="&lt;ul class=&quot;nav&quot;&gt;">
												<outline text="&lt;li class=&quot;dropdown&quot; id=&quot;idMainMenu&quot;&gt; ">
													<outline text="&lt;a href=&quot;#&quot; class=&quot;dropdown-toggle&quot; data-toggle=&quot;dropdown&quot;&gt;Menu&amp;nbsp;&lt;b class=&quot;caret&quot;&gt;&lt;/b&gt;&lt;/a&gt;">
													</outline>
													<outline text="&lt;ul class=&quot;dropdown-menu&quot;&gt;">
														<outline text="&lt;li&gt;&lt;a onclick=&quot;newPostCommand ();&quot;&gt;New post...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;showEditorCommand ();&quot; id=&quot;idShowEditor&quot;&gt;Focus on editor&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;viewMyFeedCommand ()&quot; id=&quot;idViewMyFeed&quot;&gt;View my feed...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;viewEveryonesFeedCommand ()&quot; id=&quot;idViewEveryonesFeed&quot;&gt;View everyone's feed...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;viewUserlistCommand ()&quot;&gt;View OPML user list...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="" isComment="true">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;li&gt;&lt;a onclick=&quot;supportCommand ()&quot;&gt;Support/Docs...&lt;/a&gt;&lt;/li&gt;" isComment="true">
														</outline>
														<outline text="&lt;/ul&gt;">
														</outline>
													</outline>
													<outline text="&lt;/li&gt;">
													</outline>
												</outline>
												<outline text="&lt;li class=&quot;dropdown&quot; id=&quot;idDocsMenu&quot;&gt; ">
													<outline text="&lt;a href=&quot;#&quot; class=&quot;dropdown-toggle&quot; data-toggle=&quot;dropdown&quot;&gt;Docs&amp;nbsp;&lt;b class=&quot;caret&quot;&gt;&lt;/b&gt;&lt;/a&gt;">
													</outline>
													<outline text="&lt;ul class=&quot;dropdown-menu&quot;&gt;">
														<outline text="&lt;li&gt;&lt;a href=&quot;https://demo.rss.chat/&quot; target=&quot;_blank&quot;&gt;Demo site...&lt;/a&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li class=&quot;divider&quot;&gt;&lt;/li&gt;">
														</outline>
														<outline text="&lt;li class=&quot;dropdown-submenu&quot;&gt;">
															<outline text="&lt;a href=&quot;#&quot; tabindex=&quot;-1&quot;&gt;News&lt;/a&gt;">
																<outline text="&lt;ul class=&quot;dropdown-menu&quot;&gt;">
																	<outline text="&lt;li&gt;&lt;a href=&quot;https://news.rss.chat/worknotes/rss.xml&quot; target=&quot;_blank&quot;&gt;Worknotes feed&lt;/a&gt;&lt;/li&gt;">
																	</outline>
																	<outline text="&lt;/ul&gt;">
																	</outline>
																</outline>
															</outline>

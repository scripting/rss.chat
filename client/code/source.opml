							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't delete the post because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getVersion (callback) {">
						<outline text="servercall (&quot;version&quot;, undefined, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>

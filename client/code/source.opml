														</outline>
													</outline>
													<outline text="});">
													</outline>
												</outline>
												<outline text="}">
												</outline>
											</outline>
											<outline text="else {">
												<outline text="alertDialog (&quot;Can't open the account because \&quot;&quot; + email + &quot;\&quot; is not authorized to use this service.&quot;);">

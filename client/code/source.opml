					<outline text="function userIsSignedIn () {">
						<outline text="return ((rssNetworkMemory.email !== undefined) &amp;&amp; (rssNetworkMemory.code !== undefined));">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getSocketGreeting () { //7/17/26 by CC ">
						<outline text="Changes" isComment="true">
							<outline text="7/17/26; 11:06:26 AM by CC">
								<outline text="the goodnightkiss protocol: the string that identifies this connection to the server, undefined if not signed in">
								</outline>
							</outline>
						</outline>
						<outline text="if (userIsSignedIn ()) {">
							<outline text="return (&quot;user &quot; + rssNetworkMemory.email + &quot; &quot; + rssNetworkMemory.code);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="return (undefined);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>

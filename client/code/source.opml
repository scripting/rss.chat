					<outline text="function getRecentUserItems (name, callback) { //6/26/26 by DW">
						<outline text="const screenname = getScreenname ();">
						</outline>
						<outline text="servercall (&quot;getrecentuseritems&quot;, {screenname, name}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getItemAndReplies (screenname, idparent, callback) { //6/30/26 by DW">
						<outline text="servercall (&quot;getitemandreplies&quot;, {screenname, idparent}, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function getMostActiveToday (callback) { //7/1/26 by DW">
						<outline text="servercall (&quot;getmostactivetoday&quot;, undefined, false, &quot;GET&quot;, callback);">
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function uploadMedia (type, base64text, callback) { //7/22/26 by CC -- #188">
						<outline text="if (userIsSignedIn ()) {">
							<outline text="const params = {">
								<outline text="type,">
								</outline>
								<outline text="emailaddress: rssNetworkMemory.email,">
								</outline>
								<outline text="emailcode: rssNetworkMemory.code">
								</outline>
								<outline text="};">
								</outline>
							</outline>
							<outline text="const url = options.serverAddress + &quot;uploadmedia?&quot; + buildQueryString (params);">
							</outline>
							<outline text="fetch (url, {method: &quot;POST&quot;, body: base64text}) .then (function (response) {">
								<outline text="return (response.text () .then (function (responseText) {">
									<outline text="if (response.ok) {">
										<outline text="try {">
											<outline text="const jstruct = JSON.parse (responseText);">
											</outline>
											<outline text="callback (undefined, jstruct);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="callback (err);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="else {">
										<outline text="try {">
											<outline text="const jstruct = JSON.parse (responseText);">
											</outline>
											<outline text="callback (jstruct);">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="catch (err) {">
											<outline text="callback ({message: responseText});">
											</outline>
											<outline text="}">
											</outline>
										</outline>
										<outline text="}">
										</outline>
									</outline>
									<outline text="}));">
									</outline>
								</outline>
								<outline text="})">
								</outline>
							</outline>
							<outline text=".catch (function (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="});">
								</outline>
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="const message = &quot;Can't upload the image because you are not signed in.&quot;;">
							</outline>
							<outline text="callback ({message});">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="function readHttpFile (url, callback) { //7/30/26 by DW">
						<outline text="servercall (&quot;readhttpfile&quot;, {url}, false, &quot;GET&quot;, function (err, jstruct) {">
							<outline text="if (err) {">
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="callback (undefined, jstruct.filetext);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="function start (callback) { //async stuff we do at start -- 4/22/26 by DW">
						<outline text="Changes" isComment="true">
							<outline text="6/13/26; 3:16:06 PM by DW">
								<outline text="The callback takes the standard two params. We pass back any error called by the server, the app is meant to display the message in a dialog and then do nothing. ">
								</outline>
							</outline>
						</outline>
						<outline text="console.log (&quot;rssNetworkServer.start&quot;);">
						</outline>
						<outline text="getUserData (rssNetworkMemory.screenname, function (err, userData) {">
							<outline text="if (err) {">
								<outline text="console.log (&quot;start: err.message == &quot; + err.message);">
								</outline>
								<outline text="callback (err);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="else {">
								<outline text="console.log (&quot;start: userData == &quot; + jsonStringify (userData));">
								</outline>
								<outline text="myFeedUrl = userData.feedUrl;">
								</outline>
								<outline text="baseFeedUrl = userData.baseFeedUrl;">
								</outline>
								<outline text="callback (undefined, userData);">
								</outline>
								<outline text="}">
								</outline>
							</outline>
							<outline text="});">
							</outline>
						</outline>
						<outline text="}">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="loadMemory ();">
					</outline>
					<outline text="handleEmailConfirm ();">
					</outline>
					<outline text="">
					</outline>
					<outline text="console.log (&quot;rssNetworkServer: rssNetworkMemory == &quot; + jsonStringify (rssNetworkMemory));">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.createAccount = createAccount; //4/20/26 by DW">
					</outline>
					<outline text="this.signIn = signIn; //4/19/26 by DW">
					</outline>
					<outline text="this.newPost = newPost;">
					</outline>
					<outline text="this.getVersion = getVersion;">
					</outline>
					<outline text="this.getFeed = getFeed;">
					</outline>
					<outline text="this.getFeedUrl = getFeedUrl;">
					</outline>
					<outline text="this.userIsSignedIn = userIsSignedIn;">
					</outline>
					<outline text="this.getScreenname = getScreenname;">
					</outline>
					<outline text="this.getEmail = getEmail;">
					</outline>
					<outline text="this.getBaseFeedUrl = getBaseFeedUrl; //4/23/26 by DW">
					</outline>
					<outline text="this.getSubscriptionList = getSubscriptionList; ">
					</outline>
					<outline text="this.getRecentItems = getRecentItems; //4/29/26 by DW">
					</outline>
					<outline text="this.savePrefs = savePrefs; //5/16/26 by DW">
					</outline>
					<outline text="this.willRedirect = willRedirect; //5/17/26 by DW">
					</outline>
					<outline text="this.updatePost = updatePost; //5/21/26 by DW">
					</outline>
					<outline text="this.getItemByGuid = getItemByGuid; //6/8/26 by DW">
					</outline>
					<outline text="this.checkWhitelist = checkWhitelist; //6/9/26 by DW">
					</outline>
					<outline text="this.deletePost = deletePost; //6/12/26 by DW">
					</outline>
					<outline text="this.getUserData = getUserData; //6/15/26 by DW">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.isUserInDatabase = isUserInDatabase; //6/15/26 by DW">
					</outline>
					<outline text="this.isEmailInDatabase = isEmailInDatabase; //6/15/26 by DW">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.toggleLike = toggleLike; //6/24/26 by DW">
					</outline>
					<outline text="this.getLikersList = getLikersList; //6/25/26 by DW">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.getRecentUserItems = getRecentUserItems; //6/26/26 by DW">
					</outline>
					<outline text="this.getItemAndReplies = getItemAndReplies; //6/30/26 by DW">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.getMostActiveToday = getMostActiveToday; //7/1/26 by DW">
					</outline>
					<outline text="this.getSocketGreeting = getSocketGreeting; //7/17/26 by CC">
						<outline text="this.uploadMedia = uploadMedia; //7/22/26 by CC -- #188">
						</outline>
					</outline>
					<outline text="">
					</outline>
					<outline text="this.readHttpFile = readHttpFile; //7/30/26 by DW">
					</outline>
					<outline text="">
					</outline>
					<outline text="this.signOut = signOut;">
					</outline>
					<outline text="this.start = start; //4/22/26 by DW">
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="">
				</outline>
				<outline text="function testGetSubscriptionList () {">
					<outline text="globals.myRssNetwork.getSubscriptionList (function (err, theList) {">
						<outline text="if (err) {">
							<outline text="console.log (&quot;testGetSubscriptionList: err.message == &quot; + err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;testGetSubscriptionList: theList == &quot; + jsonStringify (theList));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function testCreateAccount () {">
					<outline text="const email = &quot;dave.wine..r@gmail.com&quot;, name = &quot;Cookie Magoo&quot;;">
					</outline>
					<outline text="globals.myRssNetwork.createAccount (email, name, function (err, data) {">
						<outline text="if (err) {">
							<outline text="console.log (&quot;testCreateNewUser: err.message == &quot; + err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;testCreateNewUser: data == &quot; + jsonStringify (data));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function testSignIn () {">
					<outline text="const email = &quot;dave.winer@gmail.com&quot;;">
					</outline>
					<outline text="globals.myRssNetwork.signIn (email, function (err, data) {">
						<outline text="if (err) {">
							<outline text="console.log (&quot;testCreateNewUser: err.message == &quot; + err.message);">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="else {">
							<outline text="console.log (&quot;testCreateNewUser: data == &quot; + jsonStringify (data));">
							</outline>
							<outline text="}">
							</outline>
						</outline>
						<outline text="});">
						</outline>
					</outline>
					<outline text="}">
					</outline>
				</outline>
				<outline text="function testNewPost () {">
					<outline text="const postRec = {">
						<outline text="title: undefined, ">
						</outline>
